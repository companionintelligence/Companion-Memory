{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // ES2022, not ES2020: `new Error(msg, { cause })` (scripts/dev-stack/caddy.ts)
    // is an ES2022 signature, and under ES2020 it typechecked as a 2-argument
    // call to a 1-argument constructor. Nothing ran this config until the root
    // gained a `typecheck` script, so the error sat here unreported. The
    // Node-side preset (tsconfig.node.json) has been on ES2023 throughout.
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,

    // scripts/stage1-guards.test.ts imports the plain-ESM guards
    // (check-depcheck-ratchet.mjs, docs-check.mjs). allowJs lets tsc read their
    // JSDoc types instead of failing with TS7016 (no declaration file) and the
    // TS7006 that follows from the untyped import. checkJs stays off: the .mjs
    // files are not themselves held to this config's strict checks.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "dev-dist", ".yarn", "backend", "frontend"]
}
