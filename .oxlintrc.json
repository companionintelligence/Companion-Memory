{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/crates/oxc_linter/schemas/oxlint.schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dev-dist/**",
    "**/build/**",
    "**/coverage/**",
    ".yarn/**",
    ".pnp.*",
    ".local/**",
    "tools/**",
    ".claude/worktrees/**",
    ".worktrees/**",
    "**/.venv/**",
    "**/docs/**",
    "**/__generated__/**",
    "**/components/ui/**",
    "infrastructure/iframely/**",
    "frontend/apps/ios/ios/App/App/public/**",
    "frontend/apps/ios/ios/App/Pods/**",
    "frontend/apps/ios/ios/App/build/**",
    "frontend/apps/ios/ios/App/DerivedData/**",
    "frontend/apps/ios/ios/DerivedData/**",
    "frontend/apps/ios/ios/capacitor-cordova-ios-plugins/**",
    "frontend/apps/android/android/app/src/main/assets/public/**",
    "frontend/apps/android/android/app/build/**",
    "frontend/apps/android/android/build/**",
    "frontend/apps/android/android/capacitor-cordova-android-plugins/**",
    "frontend/apps/web/src/graphql/index.ts",
    "frontend/apps/web/src/graphql/gql.ts",
    "frontend/apps/web/src/graphql/graphql.ts",
    "frontend/apps/web/src/graphql/fragment-masking.ts",
    "frontend/apps/web/src/graphql/possibleTypes.ts"
  ],
  // Naming `plugins` REPLACES oxlint's built-in default set, so the three
  // defaults have to be repeated here — drop one and its rules silently stop
  // running. `react` is deliberately NOT in the list: oxlint leaves it off by
  // default, and adding it here would switch on ~19 rules nobody has triaged.
  "plugins": ["unicorn", "typescript", "oxc", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "off",
    "no-undef": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/no-empty-file": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/no-single-promise-in-promise-methods": "off",
    "typescript/no-useless-empty-export": "off",

    // Accessibility, deliberately a beachhead rather than the whole plugin.
    //
    // 35 of jsx-a11y's 36 rules sit in the `correctness` category, so merely
    // enabling the plugin above turns all 35 on at "error" — hundreds of
    // pre-existing violations, and a lint gate that is red on day one and
    // therefore ignored. The rules below are the ones the codebase is ALREADY
    // clean for; everything else is switched off explicitly (not left to the
    // category) so the gate cannot go red without someone editing this list.
    //
    // Turning another one on means fixing its violations in the same change.
    // `alt-text` and `role-supports-aria-props` are each a handful of files
    // away — see the a11y follow-ups.
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/role-has-required-aria-props": "error",

    "jsx-a11y/alt-text": "off",
    "jsx-a11y/anchor-ambiguous-text": "off",
    "jsx-a11y/anchor-is-valid": "off",
    "jsx-a11y/aria-activedescendant-has-tabindex": "off",
    "jsx-a11y/aria-proptypes": "off",
    "jsx-a11y/aria-role": "off",
    "jsx-a11y/autocomplete-valid": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/heading-has-content": "off",
    "jsx-a11y/html-has-lang": "off",
    "jsx-a11y/iframe-has-title": "off",
    "jsx-a11y/img-redundant-alt": "off",
    "jsx-a11y/interactive-supports-focus": "off",
    "jsx-a11y/label-has-associated-control": "off",
    "jsx-a11y/lang": "off",
    "jsx-a11y/media-has-caption": "off",
    "jsx-a11y/mouse-events-have-key-events": "off",
    "jsx-a11y/no-access-key": "off",
    "jsx-a11y/no-aria-hidden-on-focusable": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/no-distracting-elements": "off",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",
    "jsx-a11y/no-noninteractive-tabindex": "off",
    "jsx-a11y/no-redundant-roles": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/role-supports-aria-props": "off",
    "jsx-a11y/scope": "off",
    "jsx-a11y/tabindex-no-positive": "off"
  }
}
