{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/crates/oxc_linter/schemas/oxlint.schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dev-dist/**",
    "**/build/**",
    "**/coverage/**",
    ".yarn/**",
    ".pnp.*",
    ".local/**",
    "tools/**",
    ".claude/worktrees/**",
    ".worktrees/**",
    "**/.venv/**",
    "**/docs/**",
    "**/__generated__/**",
    "**/components/ui/**",
    "infrastructure/iframely/**",
    "frontend/apps/ios/ios/App/App/public/**",
    "frontend/apps/ios/ios/App/Pods/**",
    "frontend/apps/ios/ios/App/build/**",
    "frontend/apps/ios/ios/App/DerivedData/**",
    "frontend/apps/ios/ios/DerivedData/**",
    "frontend/apps/ios/ios/capacitor-cordova-ios-plugins/**",
    "frontend/apps/android/android/app/src/main/assets/public/**",
    "frontend/apps/android/android/app/build/**",
    "frontend/apps/android/android/build/**",
    "frontend/apps/android/android/capacitor-cordova-android-plugins/**",
    "frontend/apps/web/src/graphql/index.ts",
    "frontend/apps/web/src/graphql/gql.ts",
    "frontend/apps/web/src/graphql/graphql.ts",
    "frontend/apps/web/src/graphql/fragment-masking.ts",
    "frontend/apps/web/src/graphql/possibleTypes.ts"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "off",
    "no-undef": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/no-empty-file": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/no-single-promise-in-promise-methods": "off",
    "typescript/no-useless-empty-export": "off"
  }
}
