{
  "*.{ts,tsx,js,mjs}": [
    "oxlint --fix --no-error-on-unmatched-pattern",
    "eslint --fix",
    "prettier --write"
  ],
  "*.plist": ["node scripts/check-plist-duplicate-keys.mjs"],
  "frontend/apps/android/**/*.xml": ["node scripts/check-xml-comments.mjs"],
  "frontend/packages/capacitor-*/android/**/*.xml": ["node scripts/check-xml-comments.mjs"],
  "*.py": ["uv run ruff check --fix", "uv run ruff format"],
  "**/src/ci/__init__.py": ["sh scripts/check-ci-namespace.sh"],
  "frontend/apps/{android,ios}/package.json": ["node scripts/check-capacitor-native-sync.mjs"],
  "frontend/apps/android/android/capacitor.settings.gradle": ["node scripts/check-capacitor-native-sync.mjs"],
  "frontend/apps/android/android/app/capacitor.build.gradle": ["node scripts/check-capacitor-native-sync.mjs"],
  "frontend/apps/ios/ios/App/Podfile": ["node scripts/check-capacitor-native-sync.mjs"],
  "frontend/packages/capacitor-*/package.json": ["node scripts/check-capacitor-native-sync.mjs"]
}
