' Define entity colors by domain
!define USER_COLOR #E3F2FD
!define ENTITY_GRAPH_COLOR #F8BBD9
!define DEVICE_COLOR #FFE0CC
!define MEMORY_COLOR #F3E5F5
!define INTELLIGENCE_COLOR #E8F5E8
!define CONVERSATION_COLOR #FFF3E0
!define CONNECTION_COLOR #FFEBEE
!define SEARCH_COLOR #F1F8E9
!define FILES_COLOR #E0F2F1
!define ETL_COLOR #FFF8E1

' User Domain Entities
entity "users" as users <<USER_COLOR>> {
  * id : VARCHAR(PK)
  --
  * name : VARCHAR
  * email : VARCHAR(unique)
  * password : VARCHAR
  * onboarded : BOOLEAN
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
}

entity "signup_code" as signup_code <<USER_COLOR>> {
  * id : VARCHAR(PK)
  --
  * signup_code : VARCHAR(unique)
  * used : BOOLEAN
  * created_at : TIMESTAMPTZ
}

entity "sessions" as sessions <<USER_COLOR>> {
  * id : UUID(PK)
  --
  * token : TEXT
  * ip : TEXT
  * user_agent : TEXT
  * expires_at : TIMESTAMPTZ
  user_id : UUID(FK)
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
}

' Entity Graph Domain Entities
entity "entities" as entities <<ENTITY_GRAPH_COLOR>> {
  * entity_id : UUID(PK)
  --
  * entity_type : TEXT
  owner_user_id : UUID(FK)
  name : TEXT
  description : TEXT
  properties : JSONB
  embedding : VECTOR(768)
  search_content : TEXT
  linked_table : TEXT
  linked_id : UUID
  * is_active : BOOLEAN
  * is_archived : BOOLEAN
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
  * last_accessed : TIMESTAMPTZ
}

entity "relationships" as relationships <<ENTITY_GRAPH_COLOR>> {
  * relationship_id : UUID(PK)
  --
  * from_entity_id : UUID(FK)
  * to_entity_id : UUID(FK)
  * relationship_type : TEXT
  owner_user_id : UUID(FK)
  * strength : DOUBLE
  properties : JSONB
  * is_bidirectional : BOOLEAN
  * is_active : BOOLEAN
  start_date : DATE
  end_date : DATE
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
}

entity "communications" as communications <<ENTITY_GRAPH_COLOR>> {
  * time : TIMESTAMPTZ(PK)
  * user_id : UUID(PK,FK)
  * communication_type : TEXT(PK)
  --
  device_id : UUID(FK)
  * direction : TEXT
  thread_id : TEXT
  from_entity_id : UUID(FK)
  to_entity_ids : UUID[]
  participants_metadata : JSONB
  subject : TEXT
  * content : TEXT
  attachments : JSONB
  duration_seconds : INTEGER
  sentiment_score : DOUBLE
  importance_score : DOUBLE
  urgency_score : DOUBLE
  content_embedding : VECTOR(768)
  category : TEXT
  summary : TEXT
  tags : TEXT[]
  connection_id : TEXT
  * is_encrypted : BOOLEAN
  * is_archived : BOOLEAN
}

' Device & Activity Domain Entities
entity "devices" as devices <<DEVICE_COLOR>> {
  * device_id : UUID(PK)
  --
  * user_id : UUID(FK)
  device_entity_id : UUID(FK)
  * device_name : TEXT
  * device_type : TEXT
  platform : TEXT
  model : TEXT
  manufacturer : TEXT
  os_version : TEXT
  app_version : TEXT
  * last_seen : TIMESTAMPTZ
  * is_active : BOOLEAN
  * is_primary : BOOLEAN
  push_token : TEXT
  capabilities : JSONB
  privacy_settings : JSONB
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
}

entity "sensors" as sensors <<DEVICE_COLOR>> {
  * sensor_id : UUID(PK)
  --
  * device_id : UUID(FK)
  sensor_entity_id : UUID(FK)
  * sensor_name : TEXT
  * sensor_type : TEXT
  semantic_location : TEXT
  physical_location : GEOGRAPHY
  location_description : TEXT
  * measurement_types : JSONB
  measurement_units : JSONB
  sampling_rate_hz : DOUBLE
  device_info : JSONB
  calibration_data : JSONB
  * is_active : BOOLEAN
  last_reading_at : TIMESTAMPTZ
  battery_level : DOUBLE
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
}

entity "browser_activity" as browser_activity <<DEVICE_COLOR>> {
  * time : TIMESTAMPTZ(PK)
  * user_id : UUID(PK,FK)
  * device_id : UUID(PK,FK)
  --
  * url : TEXT
  domain : TEXT(generated)
  title : TEXT
  action_type : TEXT
  duration_seconds : INTEGER
  scroll_depth_percent : DOUBLE
  page_summary : TEXT
  page_embedding : VECTOR(768)
  category : TEXT
  productivity_score : DOUBLE
  * is_incognito : BOOLEAN
  * contains_sensitive : BOOLEAN
  --
  note: TimescaleDB hypertable
  note: Partitioned by time, user_id
}

entity "screen_captures" as screen_captures <<DEVICE_COLOR>> {
  * time : TIMESTAMPTZ(PK)
  * user_id : UUID(PK,FK)
  * device_id : UUID(PK,FK)
  --
  * image_path : TEXT
  thumbnail_path : TEXT
  ocr_text : TEXT
  ui_elements : JSONB
  applications : JSONB
  activity_summary : TEXT
  visual_embedding : VECTOR(768)
  text_embedding : VECTOR(768)
  primary_application : TEXT
  activity_category : TEXT
  * contains_sensitive : BOOLEAN
  * contains_pii : BOOLEAN
  * redacted : BOOLEAN
  redaction_regions : JSONB
  --
  note: TimescaleDB hypertable
  note: AI analysis with OCR
}

' Search Domain Entities
entity "tags" as tags <<SEARCH_COLOR>> {
  * id : UUID(PK)
  --
  label : TEXT(normalized)
  user_id : UUID(FK)
  * created_at : TIMESTAMPTZ
}

' Connection Domain Entities
entity "providers" as providers <<CONNECTION_COLOR>> {
  * id : UUID(PK)
  --
  name : TEXT
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
}

entity "connections" as connections <<CONNECTION_COLOR>> {
  * id : UUID(PK)
  --
  name : TEXT
  * active : BOOLEAN
  schedule : TEXT
  access_token : TEXT(encrypted)
  refresh_token : TEXT(encrypted)
  token_expiry : TIMESTAMPTZ
  sync_state : JSONB
  user_id : UUID(FK)
  provider_id : UUID(FK)
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
}

' Files Domain Entities
entity "files" as files <<FILES_COLOR>> {
  * id : UUID(PK)
  --
  * bucket : TEXT
  * key : UUID
  * original_name : TEXT
  * content_type : TEXT
  * size : BIGINT
  user_id : UUID(FK)
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
}

' Conversation Domain Entities
entity "threads" as threads <<CONVERSATION_COLOR>> {
  * id : UUID(PK)
  --
  name : TEXT
  model : TEXT
  description : TEXT
  user_id : UUID(FK)
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
  deleted_at : TIMESTAMPTZ
}

entity "messages" as messages <<CONVERSATION_COLOR>> {
  * id : UUID(PK)
  --
  model : TEXT
  role : TEXT
  text : TEXT
  mimetype : TEXT
  tool_calls : JSONB
  * prompt : BOOLEAN
  * canceled : BOOLEAN
  user_id : UUID(FK)
  thread_id : UUID(FK)
  prompt_message_id : UUID(FK)
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
  deleted_at : TIMESTAMPTZ
}

' Intelligence Domain Entities
entity "questions" as questions <<INTELLIGENCE_COLOR>> {
  * id : VARCHAR(PK)
  --
  * category : VARCHAR
  * text : VARCHAR
  * example_answer_1 : VARCHAR
  * example_answer_2 : VARCHAR
  * example_answer_3 : VARCHAR
  * subcategory : VARCHAR
  user_id : UUID(FK)
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
}

entity "answers" as answers <<INTELLIGENCE_COLOR>> {
  * id : VARCHAR(PK)
  --
  * rag_answer_1 : VARCHAR
  * rag_answer_2 : VARCHAR
  * rag_answer_3 : VARCHAR
  * give_answer_1 : VARCHAR
  * give_answer_2 : VARCHAR
  * give_answer_3 : VARCHAR
  user_id : UUID(FK)
  question_id : VARCHAR(FK)
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
}

entity "actions" as actions <<INTELLIGENCE_COLOR>> {
  * id : UUID(PK)
  --
  title : TEXT
  text : TEXT
  image_url : TEXT
  priority : INTEGER
  thread_id : TEXT(FK)
  user_id : UUID(FK)
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
}

' Legacy Memory Domain Entities
entity "events" as events <<MEMORY_COLOR>> {
  * id : UUID(PK)
  --
  type : TEXT
  name : TEXT
  description : TEXT
  start_time : TIMESTAMPTZ
  end_time : TIMESTAMPTZ
  external_id : TEXT
  source_url : TEXT
  source_data : JSONB
  user_id : UUID(FK)
  connection_id : UUID(FK)
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
  --
  note: Legacy table
}

entity "content" as content <<MEMORY_COLOR>> {
  * id : UUID(PK)
  --
  * type : TEXT
  title : TEXT
  text : TEXT
  url : TEXT
  mimetype : TEXT
  external_id : TEXT
  source_url : TEXT
  source_data : JSONB
  user_id : UUID(FK)
  event_id : UUID(FK)
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
  --
  note: Legacy table
}

' ETL Domain Entities
entity "api_logs" as api_logs <<ETL_COLOR>> {
  * id : UUID(PK)
  --
  user_id : UUID(FK)
  connection_id : UUID(FK)
  scope : TEXT
  content : JSONB
  last_processed : TIMESTAMPTZ
  * created_at : TIMESTAMPTZ
  --
  note: TimescaleDB hypertable
  note: Partitioned by created_at, user_id
  note: Composite PK: (id, created_at, user_id)
}

' Active Join Tables
entity "action_tag" as action_tag {
  * id : BIGINT(PK)
  --
  * action_id : UUID(FK)
  * tag_id : UUID(FK)
  * created_at : TIMESTAMPTZ
}

entity "content_tag" as content_tag {
  * id : BIGINT(PK)
  --
  * content_id : UUID(FK)
  * tag_id : UUID(FK)
  * created_at : TIMESTAMPTZ
}

entity "event_tag" as event_tag {
  * id : BIGINT(PK)
  --
  * event_id : UUID(FK)
  * tag_id : UUID(FK)
  * created_at : TIMESTAMPTZ
}

entity "thread_file" as thread_file {
  * id : BIGINT(PK)
  --
  * thread_id : UUID(FK)
  * file_id : UUID(FK)
  * created_at : TIMESTAMPTZ
}

entity "message_files" as message_files {
  * message_id : UUID(PK,FK)
  * file_id : UUID(PK,FK)
  --
  * created_at : TIMESTAMPTZ
}

