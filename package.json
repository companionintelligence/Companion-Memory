{
  "name": "@ci/ci-server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "oxlint && eslint --cache",
    "lint:fix": "oxlint --fix && eslint --fix --cache",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs}\"",
    "e2e": "PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test --config playwright.e2e.config.ts",
    "e2e:desktop": "PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test --config playwright.desktop.config.ts",
    "fed": "yarn workspace @ci/be-api run exec -- scripts/federation-harness/index.ts",
    "e2e:ui": "PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test --config playwright.e2e.config.ts --ui",
    "e2e:headed": "PLAYWRIGHT_FORCE_ASYNC_LOADER=1 playwright test --config playwright.e2e.config.ts --headed",
    "e2e:report": "playwright show-report",
    "test": "node --require ./scripts/pnp-tsx-compat.cjs --import tsx --test \"scripts/*.test.ts\" \"scripts/xtask/**/*.test.ts\" \"scripts/dev-stack/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "husky && sh scripts/merge-uv-lock.sh --register",
    "lint:canon": "ci-lint-canon . && yarn workspace @ci/fe-web brand:check"
  },
  "packageManager": "yarn@4.9.1",
  "workspaces": [
    "backend/apps/*",
    "backend/packages/*",
    "frontend/apps/*",
    "frontend/packages/*",
    "!frontend/apps/ios",
    "!frontend/apps/android",
    "!frontend/apps/desktop"
  ],
  "resolutions": {
    "@graphql-tools/utils@npm:^11.0.0": "^12.1.0",
    "@nestjs/graphql/@graphql-tools/utils": "^12.1.0",
    "@protobufjs/utf8": "^1.1.1",
    "dompurify": "^3.4.17",
    "esbuild@npm:^0.27.0": "^0.28.2",
    "fast-xml-parser": "4.5.5",
    "flatted": "^3.4.2",
    "form-data": "^4.0.6",
    "glob@npm:11.0.1": "11.1.0",
    "ip-address": "^10.7.4",
    "js-yaml": "^4.3.2",
    "markdown-it": "^14.3.3",
    "mdast-util-to-hast": "^13.2.1",
    "multer": "^2.5.0",
    "path-to-regexp": "^8.4.0",
    "picomatch@npm:4.0.2": "4.0.4",
    "postcss": "^8.5.23",
    "postcss-selector-parser@npm:6.0.10": "^6.1.5",
    "serialize-javascript": "^7.1.3",
    "shell-quote": "^1.11.0",
    "smol-toml": "^1.9.0",
    "tar": "^7.5.22",
    "minimatch@npm:<10/brace-expansion": "^2.1.7",
    "tmp": "^0.2.6",
    "undici": "^8.12.2",
    "fast-uri": "^3.1.9",
    "lodash": "^4.18.1",
    "ws": "^8.21.0",
    "@yarnpkg/sdks/@yarnpkg/core": "4.9.1"
  },
  "dependenciesMeta": {
    "@apollo/protobufjs": {
      "built": true
    },
    "@journeyapps/wa-sqlite": {
      "built": true
    },
    "@parcel/watcher": {
      "built": true
    },
    "@swc/core": {
      "built": true
    },
    "bcrypt": {
      "built": true
    },
    "better-sqlite3": {
      "built": true
    },
    "esbuild": {
      "built": true
    },
    "unrs-resolver": {
      "built": true
    }
  },
  "devDependencies": {
    "@companionintelligence/config": "^1.0.0",
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.1",
    "@types/pg": "^8",
    "@yarnpkg/sdks": "^3.3.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "oxlint": "^1.36.0",
    "prettier": "^3.5.3",
    "tsx": "^4.7.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.4.4",
    "yaml": "^2.8.1"
  }
}
