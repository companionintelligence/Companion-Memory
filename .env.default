############
# API KEYS #
############

# Third-party API keys are secrets and must NOT be committed. Leave blank here and
# provide real values via a local .env (gitignored) or injected env at deploy time.
# TMDB (movie/TV enrichment) and Google Maps (geocoding) are optional; when unset
# those enrichment paths are skipped.
TMDB_API_KEY=
GOOGLE_MAPS_KEY=

