{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["workspace", "@ci/fe-web", "dev"],
      "port": 5173,
      "autoPort": true,
      "env": {
        "API_PROXY_TARGET": "http://localhost:3030"
      }
    },
    {
      "name": "api",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["workspace", "@ci/be-api", "dev"],
      "port": 3030,
      "autoPort": true
    },
    {
      "name": "storybook",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["workspace", "@ci/fe-web", "storybook"],
      "port": 6006
    }
  ]
}
