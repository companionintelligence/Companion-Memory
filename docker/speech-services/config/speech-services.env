# Base speech services configuration
SPEECH_SERVICES_IMAGE=ci/speech-services

# STT Configuration Options:
# - whisper: OpenAI Whisper (local)
# - mock: Mock service for testing
# - higgs: Higgs Boson API (future)
# - vibe: Microsoft VibeVoice (future)
# - sesame: Sesame (future)
STT_ENGINE=whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# TTS Configuration Options:
# - piper: Piper TTS (local)
# - mock: Mock service for testing  
# - higgs: Higgs Boson API (future)
# - vibe: Microsoft VibeVoice (future)
TTS_ENGINE=piper
PIPER_VOICE=en_US-ljspeech-medium

# Model cache directory (mounted volume)
MODEL_CACHE_DIR=/app/models

# API Keys for external services (when implemented)
# HIGGS_API_KEY=your_higgs_api_key
# HIGGS_ENDPOINT=https://api.boson.ai
# HF_TOKEN=your_huggingface_token