# =============================================================================
# CI-Server environment variables — example / template
# =============================================================================
# CI-Server uses node-config: `backend/apps/api/config/custom-environment-variables.json`
# is the authoritative env -> config map, and `default.json` holds the defaults.
# This file documents those same variables for local / Docker runs.
# `make init` copies `.env.default` (not this file) to `.env`. Keep the
# FEATURES lists in both files identical so they cannot drift.
#
# On the appliance, CI-Hub installs CI-Server as the "ci-memory" app and injects
# the infrastructure + connect values automatically — you only set these by hand
# for a standalone run.
# =============================================================================

# Node environment: production | development | test
#NODE_ENV=development

# Public hostname CI-Server is reached at (used to build absolute URLs).
#APP_PUBLIC_HOSTNAME=ci-server.localhost

# HTTP port the API binds to.
#PORT=3030

# ---------------------------------------------------------------------------
# Auth secrets — REQUIRED in any real deployment (use long random values)
# ---------------------------------------------------------------------------
# Never commit a real value for anything in this block — not here, not in
# `.env.default`. On a real deployment these are generated per-box on first boot
# by infrastructure/setup-secrets/entrypoint.sh into the shared secrets file
# ($SECRETS_FILE, default /run/secrets/.env.secrets) and read from there by each
# service entrypoint; you only set them by hand for a standalone run. To make
# your own: `openssl rand -hex 32` (required format for the field-encryption
# key) or `openssl rand -base64 48` (everything else). Put them in `.env`, which
# is gitignored.

# Signing secret for short-lived access tokens.
#AUTH_TOKEN_SECRET=<random-secret>
# Signing secret for refresh tokens (distinct from the access-token secret).
#AUTH_REFRESH_TOKEN_SECRET=<random-secret>
# Pepper mixed into hashed session fields.
#AUTH_SESSION_PEPPER=<random-secret>
# Double-submit CSRF token secret.
#AUTH_CSRF_TOKEN_SECRET=<random-secret>
# Key used for AES-256-GCM field encryption of stored secrets (incl. the
# memory-connect keys). Must be stable — rotating it makes existing ciphertext
# unreadable.
#AUTH_FIELD_ENCRYPTION_KEY=<random-32-byte-key>

# OAuth callback URL (when acting as an OAuth client).
#OAUTH_CALLBACK_URL=

# --- OIDC relying-party ---
# Issuer URL of the IdP CI-Server trusts for sign-in.
#OIDC_ISSUER_URL=
# Public base URL of this app, used to build the OIDC redirect_uri.
#APP_BASE_URL=

# --- App-connect (Companion Memory brokered by CI-Hub) ---
# Comma-separated allowlist of CI-Hub origins the consent flow may redirect back
# to after minting a scoped key (open-redirect guard). Injected by CI-Hub as
# CI_HUB_ORIGINS at install. Empty disables the connect redirect entirely.
#CI_HUB_ORIGINS=
#CI_HUB_INTERNAL_URL=http://ci-os-hub:3000

# --- CORS — additional cross-origin web clients (REST/GraphQL) ---
# Comma-separated allowlist of extra origins allowed to call the API
# cross-origin with credentials (cookies + Authorization header). The native
# Capacitor webview origins (capacitor://localhost, ionic://localhost,
# http(s)://localhost) are always allowed and never need to be listed here;
# the web app itself is served same-origin behind the proxy and needs no
# entry either. Defaults to empty, so only those native origins can reach the
# API — set this to let a separately-hosted web client (e.g. a Companion
# Spatial / CI-Spatial-Web SPA on Cloudflare Pages) authenticate cross-origin.
# Distinct from CI_HUB_ORIGINS above, which only scopes the CI-Hub
# consent-redirect flow.
#CORS_ALLOWED_ORIGINS=https://ci-spatial-web.pages.dev

# DEV ONLY — ring OpenClaw's /hooks/wake directly, skipping Hub.
#
# A local dev stack cannot reach Hub (the URL above names a Docker alias no
# CI-Server compose file defines, and the forward-auth secret is empty), so
# dispatch cannot be exercised without a full Hub install. This is the escape
# hatch. Both lines are required — a URL without a token is a silent miss.
#
# The URL is LOOPBACK-ENFORCED at config parse time: set it to anything off-box
# and the process refuses to boot. The token is OpenClaw's own HUB_WAKE_SECRET.
#
# Never set these on an appliance. Hub always wins when it is configured, and
# this is never a fallback after a Hub failure — but it does hand CI-Server a
# credential that can queue text into the owner's main agent session.
#CI_DEV_DIRECT_WAKE_URL=http://127.0.0.1:18789
#CI_DEV_DIRECT_WAKE_TOKEN=

# --- CI-Portal as OIDC provider ---
# Defaults to TRUE. Every capture client (browser extension, applet, importer)
# authenticates only with a portal token, so turning this off makes all of them
# 401 with no diagnostic. Leaving it on is safe for servers that don't use it:
# a token failing portal verification falls through to the legacy JWT and
# api-key strategies unchanged. Set false only to deliberately refuse portal
# tokens.
#PORTAL_OIDC_ENABLED=true
#PORTAL_OIDC_ISSUER=
#PORTAL_OIDC_JWKS_URI=
# Comma-separated accepted `aud` values (CI-Portal sets aud === client_id).
# Overrides config default; include every first-party client you accept, e.g.:
#PORTAL_OIDC_AUDIENCE=ci-server,ci-hub,ci-import-tools,ci-browser-extension,ci-even,ci-applet

# --- Hub forward-auth (S2S identity + memory-connect signature verification) ---
# Enable verification of CI-Hub's signed forward-auth headers.
#CI_HUB_FORWARD_AUTH_ENABLED=false
# Shared HMAC secret; must match the value CI-Hub signs with. Injected by CI-Hub.
#CI_HUB_FORWARD_AUTH_SECRET=
# Allowed clock skew (ms) for the signed-request timestamp.
#CI_HUB_FORWARD_AUTH_MAX_SKEW_MS=

# ---------------------------------------------------------------------------
# Database (PostgreSQL) — REQUIRED
# ---------------------------------------------------------------------------
#DATABASE_HOST=localhost
#DATABASE_PORT=5432
#DATABASE_USERNAME=postgres
#DATABASE_PASSWORD=<db-password>
# Log every SQL query (verbose; dev only).
#DATABASE_QUERY_LOGGING=false

# ---------------------------------------------------------------------------
# Object storage (Minio / S3-compatible) — static files
# ---------------------------------------------------------------------------
#OBJECT_STORE_URL=
#OBJECT_STORE_USERNAME=
#OBJECT_STORE_PASSWORD=

# ---------------------------------------------------------------------------
# Local model services
# ---------------------------------------------------------------------------
# Ollama host for chat/LLM calls.
#OLLAMA_HOST=http://localhost:11434
# HBPE (behavioral-prediction) Python sidecar host.
#HBPE_HOST=http://localhost:8001

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# Embedding endpoint, when it should differ from the chat backend (any engine;
# an OpenAI-style base or a bare host). OLLAMA_EMBED_HOST is the deprecated name.
#LLM_EMBEDDING_API_BASE=http://localhost:11434
#CI_EMBED_MODEL=
#CI_EMBED_BATCH_SIZE=
#CI_EMBED_CONCURRENCY=
#CI_EMBED_COALESCE_WINDOW_MS=
#CI_EMBED_MIN_TEXT_LENGTH=
# Comma-separated record types eligible for embedding.
#CI_EMBED_TYPES=

# ---------------------------------------------------------------------------
# Background queues (PGBoss)
# ---------------------------------------------------------------------------
#CI_QUEUE_CONCURRENCY=
#CI_QUEUE_FETCH_BATCH_SIZE=

# ---------------------------------------------------------------------------
# CI-Portal (cloud) linkage
# ---------------------------------------------------------------------------
#CI_CLOUD_URL=https://hub.ci.computer
#HUB_DEVICE_ID=
#HUB_API_KEY=

# ---------------------------------------------------------------------------
# Geocoding / Maps (optional — maintenance geocode + Memory map Directions)
# ---------------------------------------------------------------------------
# Hub-installed Memory receives these from Portal (wrangler secret
# GOOGLE_MAPS_API_KEY → Hub injects into app.env). Local `make dev` can set
# either var; GEOCODING_API_KEY wins when both are set. The web UI loads the
# same key at runtime from GET /api/config/maps (no Vite bake required).
#GEOCODING_API_KEY=
#GOOGLE_MAPS_KEY=
# Optional local-only frontend bake (prefer runtime /api/config/maps):
#VITE_GOOGLE_MAPS_API_KEY=
#GEOCODING_BATCH_SIZE=
#GEOCODING_RATE_LIMIT_PER_SECOND=
# Prod geocode via hub. The appliance appends the Portal paths:
#   forward  https://hub.ci.computer/api/geocode
#   reverse  https://hub.ci.computer/api/geocode/reverse
GEOCODING_PORTAL_BASE_URL=https://hub.ci.computer
#GEOCODING_PROVIDER=portal

# Grounded chat recall. When on, a chat turn pre-runs memory recall for the
# newest user message and inserts the result into the fenced turn-context block,
# instead of relying on the model to choose the recall tool. Fails open.
# LLM_CHAT_GROUNDED_RECALL_ENABLED=true
#
# Maximum GraphQL query nesting depth, alongside the existing complexity ceiling.
# GRAPHQL_MAX_DEPTH=12
#
# Failed-login throttle, per client IP + submitted username. The appliance is
# reachable from the internet when exposed through the Portal, and this is the
# only brute-force protection on the login path. Fails open on internal error.
# AUTH_LOGIN_THROTTLE_ENABLED=true
# AUTH_LOGIN_THROTTLE_MAX_ATTEMPTS=10
# AUTH_LOGIN_THROTTLE_WINDOW_SECONDS=900
# AUTH_LOGIN_THROTTLE_LOCKOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Keep this list identical in `.env.default`. Values match
# `backend/apps/api/config/default.json`. Leave them commented so a copied
# `.env` does not override those defaults.
# Require an invite/signup code for new accounts. The appliance sets this FALSE
# so first-time OIDC users can JIT-provision (a stock dev server defaults to true).
# ENABLE_SCHEDULED_ANSWER_INFERENCING=true
# ENABLE_SCHEDULED_CONNECTION_SYNC=true
# ENABLE_PINNED_DEMO_MODELS=false
# ENABLE_SYSTEM_PROMPT=true
# ENABLE_ADVANCED_THEME_TAB=false
# ENABLE_REQUIRE_SIGNUP_CODES=true
# ENABLE_FILES_PAGE=true
# ENABLE_INSIGHTS_PAGE=true
# ENABLE_CHAT_PAGE=true
# ENABLE_JOBS_PAGE=true
# ENABLE_IMPORT_PAGE=true
# ENABLE_PLANNING=true
# ENABLE_PLANNING_PAGE=true
# ENABLE_PLANNING_EMPTY_STATE=false
# ENABLE_STATS_PAGE=true
# ENABLE_SCHEDULE_PAGE=true
# ENABLE_TAGS_PAGE=true
# Gates the Today home route, the list surface for summaries, insights and derived actions.
# ENABLE_TODAY_PAGE=false
# ENABLE_HBPE=true
# ENABLE_AGENT_MEMORY_COMPACTION=false
# ENABLE_SHARED_SEARCH=true
# ENABLE_ONBOARDING_PREFERENCE_STEPS=false
# ENABLE_ACTIONS=true
# ENABLE_SMART_ROTATION=false
# ENABLE_ASK=false
# ENABLE_GROUNDED_PROMPTS=true
# ENABLE_DERIVATION_ENGINES=true

# ---------------------------------------------------------------------------
# Error reporting (Sentry) — OPT-OUT: on wherever a DSN is set
# ---------------------------------------------------------------------------
# With no DSN set, no Sentry code initialises and no component makes an
# outbound connection. DSNs are per component, so a crash lands in the right
# project; see docs/operations/error-reporting.md.
#SENTRY_DSN_API=https://<key>@o<org-id>.ingest.us.sentry.io/<ci-server-api-id>
#SENTRY_DSN_HBPE=https://<key>@o<org-id>.ingest.us.sentry.io/<ci-server-hbpe-id>
#SENTRY_DSN_SUMMARY=https://<key>@o<org-id>.ingest.us.sentry.io/<ci-server-summary-id>
# Baked into the web bundle at build time (yarn workspace @ci/fe-web build):
#VITE_SENTRY_DSN=https://<key>@o<org-id>.ingest.us.sentry.io/<ci-server-web-id>
#VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
#VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
#VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
#VITE_SENTRY_ENABLE_METRICS=true
#VITE_SENTRY_ENABLE_LOGS=true
#SENTRY_TRACES_SAMPLE_RATE=0.1
#SENTRY_PROFILES_SAMPLE_RATE=0.1
#SENTRY_ENABLE_METRICS=true
#SENTRY_ENABLE_LOGS=true

# Kill switches — these win over a DSN, including one baked into an image, so
# an operator can disable reporting without a rebuild.
#CI_TELEMETRY=off
#CI_LOCAL_ONLY=true

# Optional labelling.
#SENTRY_ENV=production
#CI_SERVER_VERSION=2026.8.1
