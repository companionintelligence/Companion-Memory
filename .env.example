# =============================================================================
# CI-Server environment variables — example / template
# =============================================================================
# CI-Server uses node-config: `backend/apps/api/config/custom-environment-variables.json`
# is the authoritative env -> config map, and `default.json` holds the defaults.
# This file documents those same variables for local / Docker runs. Copy to
# `.env` and set the values you need.
#
# On the appliance, CI-Hub installs CI-Server as the "ci-memory" app and injects
# the infrastructure + connect values automatically — you only set these by hand
# for a standalone run.
# =============================================================================

# Node environment: production | development | test
#NODE_ENV=development

# Public hostname CI-Server is reached at (used to build absolute URLs).
#APP_PUBLIC_HOSTNAME=ci-server.localhost

# HTTP port the API binds to.
#PORT=3030

# ---------------------------------------------------------------------------
# Auth secrets — REQUIRED in any real deployment (use long random values)
# ---------------------------------------------------------------------------

# Signing secret for short-lived access tokens.
#AUTH_TOKEN_SECRET=<random-secret>
# Signing secret for refresh tokens (distinct from the access-token secret).
#AUTH_REFRESH_TOKEN_SECRET=<random-secret>
# Pepper mixed into hashed session fields.
#AUTH_SESSION_PEPPER=<random-secret>
# Double-submit CSRF token secret.
#AUTH_CSRF_TOKEN_SECRET=<random-secret>
# Key used for AES-256-GCM field encryption of stored secrets (incl. the
# memory-connect keys). Must be stable — rotating it makes existing ciphertext
# unreadable.
#AUTH_FIELD_ENCRYPTION_KEY=<random-32-byte-key>

# OAuth callback URL (when acting as an OAuth client).
#OAUTH_CALLBACK_URL=

# --- OIDC relying-party ---
# Issuer URL of the IdP CI-Server trusts for sign-in.
#OIDC_ISSUER_URL=
# Public base URL of this app, used to build the OIDC redirect_uri.
#APP_BASE_URL=

# --- App-connect (Companion Memory brokered by CI-Hub) ---
# Comma-separated allowlist of CI-Hub origins the consent flow may redirect back
# to after minting a scoped key (open-redirect guard). Injected by CI-Hub as
# CI_HUB_ORIGINS at install. Empty disables the connect redirect entirely.
#CI_HUB_ORIGINS=

# --- CI-Portal as OIDC provider ---
#PORTAL_OIDC_ENABLED=false
#PORTAL_OIDC_ISSUER=
#PORTAL_OIDC_JWKS_URI=
# Comma-separated accepted `aud` values (CI-Portal sets aud === client_id).
# Overrides config default; include every first-party client you accept, e.g.:
#PORTAL_OIDC_AUDIENCE=ci-server,ci-hub,ci-import-tools,ci-browser-extension,ci-even

# --- Hub forward-auth (S2S identity + memory-connect signature verification) ---
# Enable verification of CI-Hub's signed forward-auth headers.
#CI_HUB_FORWARD_AUTH_ENABLED=false
# Shared HMAC secret; must match the value CI-Hub signs with. Injected by CI-Hub.
#CI_HUB_FORWARD_AUTH_SECRET=
# Allowed clock skew (ms) for the signed-request timestamp.
#CI_HUB_FORWARD_AUTH_MAX_SKEW_MS=

# ---------------------------------------------------------------------------
# Database (PostgreSQL) — REQUIRED
# ---------------------------------------------------------------------------
#DATABASE_HOST=localhost
#DATABASE_PORT=5432
#DATABASE_USERNAME=postgres
#DATABASE_PASSWORD=<db-password>
# Log every SQL query (verbose; dev only).
#DATABASE_QUERY_LOGGING=false

# ---------------------------------------------------------------------------
# Object storage (Minio / S3-compatible) — static files
# ---------------------------------------------------------------------------
#OBJECT_STORE_URL=
#OBJECT_STORE_USERNAME=
#OBJECT_STORE_PASSWORD=

# ---------------------------------------------------------------------------
# Local model services
# ---------------------------------------------------------------------------
# Ollama host for chat/LLM calls.
#OLLAMA_HOST=http://localhost:11434
# HBPE (behavioral-prediction) Python sidecar host.
#HBPE_HOST=http://localhost:8001

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# Ollama host used for embeddings (may differ from the chat host).
#OLLAMA_EMBED_HOST=http://localhost:11434
#CI_EMBED_MODEL=
#CI_EMBED_BATCH_SIZE=
#CI_EMBED_CONCURRENCY=
#CI_EMBED_COALESCE_WINDOW_MS=
#CI_EMBED_MIN_TEXT_LENGTH=
# Comma-separated record types eligible for embedding.
#CI_EMBED_TYPES=

# ---------------------------------------------------------------------------
# Background queues (PGBoss)
# ---------------------------------------------------------------------------
#CI_QUEUE_CONCURRENCY=
#CI_QUEUE_FETCH_BATCH_SIZE=

# ---------------------------------------------------------------------------
# CI-Portal (cloud) linkage
# ---------------------------------------------------------------------------
#CI_CLOUD_URL=https://hub.ci.computer
#HUB_DEVICE_ID=
#HUB_API_KEY=

# ---------------------------------------------------------------------------
# Geocoding (optional — the `geocode` maintenance step)
# ---------------------------------------------------------------------------
#GEOCODING_API_KEY=
#GEOCODING_BATCH_SIZE=
#GEOCODING_RATE_LIMIT_PER_SECOND=

# ---------------------------------------------------------------------------
# Feature flags (all boolean; default off unless noted in default.json)
# ---------------------------------------------------------------------------
# Require an invite/signup code for new accounts. The appliance sets this FALSE
# so first-time OIDC users can JIT-provision (a stock dev server defaults to true).
#ENABLE_REQUIRE_SIGNUP_CODES=false
#ENABLE_SCHEDULED_ANSWER_INFERENCING=
#ENABLE_SCHEDULED_CONNECTION_SYNC=
#ENABLE_SCHEDULED_ENTITY_PROMOTION=
#ENABLE_PINNED_DEMO_MODELS=
#ENABLE_SYSTEM_PROMPT=
#ENABLE_INVENTORY_PAGE=
#ENABLE_ADVANCED_THEME_TAB=
#ENABLE_NEW_INSIGHTS_PAGE=
#ENABLE_FILES_PAGE=
#ENABLE_INSIGHTS_PAGE=
#ENABLE_CHAT_PAGE=
#ENABLE_JOBS_PAGE=
#ENABLE_STATS_PAGE=
#ENABLE_TAGS_PAGE=
#ENABLE_HBPE=
#ENABLE_AGENT_MEMORY_COMPACTION=
#ENABLE_SHARED_SEARCH=
