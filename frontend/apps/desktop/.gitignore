node_modules
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins

# Rust build output and any platform target generated by `tauri android`/`tauri
# ios` (not used here — desktop only) if ever invoked by mistake.
src-tauri/target
src-tauri/gen

# Synced verbatim from the repo root by scripts/sync-compose-resources.cjs on
# every dev/build — never hand-edit or commit these; they must always match
# docker-compose.yml / docker-compose.production.yml exactly.
src-tauri/resources/docker-compose.yml
src-tauri/resources/docker-compose.production.yml
src-tauri/resources/image-tag.txt

# Compiled by src-tauri/build.rs on macOS from src-tauri/apple-bridge and
# copied into src-tauri/resources/apple-bridge/ — never hand-edit or commit
# the binary.
src-tauri/apple-bridge/.build
src-tauri/resources/apple-bridge

# Downloaded on demand by local_model::ollama_sidecar when the host has no
# usable Ollama — never committed, verified by pinned checksum at fetch time.
src-tauri/ollama-runtime
