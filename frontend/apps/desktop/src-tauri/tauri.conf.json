{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Companion Memory",
  "mainBinaryName": "ci-server-desktop",
  "version": "0.1.0",
  "identifier": "computer.ci.app.server",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../bootstrap"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/*": "resources/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Companion Memory",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "backgroundColor": "#0b1720"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["companion"]
      }
    }
  }
}
