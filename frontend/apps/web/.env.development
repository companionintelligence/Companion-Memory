# iOS / local Vite: cloud-connect against the PROD Portal. The phone default is
# hardcoded to hub.ci.computer in DeviceConnectPage/portal-client.ts; this line
# is only documentation for other Vite callers. Advanced can still override.
# A previously persisted hub.companionintelligence.com is ignored on read.
VITE_CI_CLOUD_URL=https://hub.ci.computer
