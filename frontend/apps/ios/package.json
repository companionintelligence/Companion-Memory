{
  "name": "@ci/fe-ios",
  "version": "0.0.0",
  "private": true,
  "description": "Native iOS shell (Capacitor) wrapping the @ci/fe-web build as a thin client. Standalone project (NOT a yarn workspace) so the root Yarn PnP install stays intact; it consumes the web build via webDir, not as a dependency.",
  "packageManager": "yarn@4.9.1",
  "resolutions": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  },
  "scripts": {
    "build:web": "cd ../../.. && VITE_DISABLE_PWA=true yarn workspace @ci/fe-web build",
    "sync:safari-extension": "bash scripts/sync-safari-extension.sh",
    "sync": "cap sync ios && yarn sync:safari-extension",
    "build": "yarn build:web && yarn sync",
    "open": "cap open ios",
    "ios": "cap run ios"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@ci/capacitor-app-lock": "portal:../../packages/capacitor-app-lock",
    "@ci/capacitor-local-hub": "portal:../../packages/capacitor-local-hub",
    "@ci/capacitor-local-llm": "portal:../../packages/capacitor-local-llm",
    "@ci/capacitor-speech": "portal:../../packages/capacitor-speech",
    "@powersync/capacitor": "^0.9.4",
    "capacitor-secure-storage-plugin": "^0.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "^5.8.3"
  }
}
