ios/App/SafariWebExtension/Resources/*
!ios/App/SafariWebExtension/Resources/.gitkeep

# Generated iOS native project artifacts. The ios/ tree is committed.
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/DerivedData/
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/capacitor-cordova-ios-plugins/

*.log
.DS_Store
