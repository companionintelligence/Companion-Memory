# PWA icon output from `@capacitor/assets generate` — unused by the native build
# (icons live in ios/; the source artwork is in assets/).
icons/

# Dependencies (this workspace uses the node-modules linker — see .yarnrc.yml).
node_modules/
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins

