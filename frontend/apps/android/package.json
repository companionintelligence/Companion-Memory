{
  "name": "@ci/fe-android",
  "version": "0.0.0",
  "private": true,
  "description": "Native Android shell (Capacitor) wrapping the @ci/fe-web build as a thin client. Standalone project (NOT a yarn workspace) so the root Yarn PnP install stays intact; it consumes the web build via webDir, not as a dependency.",
  "packageManager": "yarn@4.9.1",
  "scripts": {
    "build:web": "cd ../../.. && VITE_DISABLE_PWA=true yarn workspace @ci/fe-web build",
    "sync": "cap sync android",
    "build": "yarn build:web && yarn sync",
    "open": "cap open android",
    "run": "cap run android"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "patch:@capacitor-community/background-geolocation@npm%3A1.2.26#~/.yarn/patches/@capacitor-community-background-geolocation-npm-1.2.26-e4d02e234f.patch",
    "@capacitor-community/sqlite": "^7.0.1",
    "@capacitor-mlkit/barcode-scanning": "^7.5.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@ci/capacitor-local-hub": "portal:../../packages/capacitor-local-hub",
    "@ci/capacitor-local-llm": "portal:../../packages/capacitor-local-llm",
    "@ci/capacitor-speech": "portal:../../packages/capacitor-speech",
    "@powersync/capacitor": "^0.5.2",
    "capacitor-secure-storage-plugin": "^0.11.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "typescript": "^5.8.3"
  }
}
