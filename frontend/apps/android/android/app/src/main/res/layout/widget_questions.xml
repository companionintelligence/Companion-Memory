<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="QUESTIONS"
        android:textColor="#70E1D8"
        android:textSize="12sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/questions_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="What would you like to understand?"
        android:textColor="#F5F8FA"
        android:textSize="17sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/questions_description"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="top"
        android:text="Ask across your saved memories and records."
        android:textColor="#9EADB6"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/questions_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="Ask Memory  ↗"
        android:textColor="#70E1D8"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
