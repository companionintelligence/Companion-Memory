<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <!-- @capacitor-mlkit/barcode-scanning: required so Play Services can resolve the
             on-demand ML Kit barcode model at scan time (the `scan()` entry point used by
             the QR-to-connect flow launches Google's own scanner UI/module, not a bundled
             model, so this only advertises which ML Kit dependency to fetch). -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OIDC deep-link return. Keep the scheme in sync with iOS Info.plist
                 CFBundleURLTypes, @ci/common OIDC_NATIVE_SCHEME, and
                 auth.oidc.nativeRedirectScheme.
                 host=oidc is CI-Server appliance login (companion://oidc/callback).
                 host=auth is Portal cloud-connect PKCE (companion://auth/callback). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="companion" android:host="oidc" />
                <data android:scheme="companion" android:host="auth" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Camera/mic for the in-webview capture (getUserMedia in @ci/capture). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Local notifications (Android 13+ runtime permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Location. Both COARSE and FINE are declared because the runtime prompt for
      FINE offers the user a "coarse only" choice; without COARSE declared, that
      choice yields no permission at all rather than a degraded one.

      The "Always" mode is @ci/capacitor-local-hub's motion-gated tracker
      (location/LocationTracker.kt): GPS runs only while the phone is moving,
      through a foreground service of type `location` that shows the "Recording
      location" notification for those minutes only, and an exit geofence around
      the resting spot is what starts it again. ACCESS_BACKGROUND_LOCATION is what
      lets Play Services hold that geofence and deliver it to a process with no
      activity alive, and what lets the service receive location when it was
      started that way. FOREGROUND_SERVICE_LOCATION lets the service start on
      Android 14+. Play therefore needs BOTH the background-location declaration
      with its demo video AND the foreground-service `location` declaration with
      its own (DEVICE_DATA_COMPLIANCE.md §3.4) before a build carrying this
      manifest goes to any track. AndroidManifestContractTest fails if either
      permission goes missing.

      What location commits us to (§8): an in-app prominent-disclosure screen
      shown immediately before each runtime prompt — not in the store listing, not
      in the privacy policy — with an affirmative "Agree" button, a working
      decline path, and graceful degradation. Plus a Play location Permissions
      Declaration and `Location -> Precise location` in Data Safety.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Location hardware is optional: the app is fully usable with tracking off. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Package visibility (required since Android 11 / API 30, and this app targets 35).
         Every text-to-speech engine lives in its own package, and an app targeting API 30+
         cannot bind to a service in a package it cannot "see". Without this declaration
         TextToSpeech's OnInitListener fires with ERROR and no voice is ever available, with
         no other diagnostic. @ci/capacitor-speech declares the same element in its own
         library manifest; the merger unions them, and it is repeated here because this is
         the module that declares the targetSdk which triggers the requirement. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
