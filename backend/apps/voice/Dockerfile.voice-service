# Use Python 3.11 slim image as base
FROM python:3.11-slim

# Fix potential credential issues
ENV DOCKER_BUILDKIT=1

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    git \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements files
COPY apps/voice/requirements.txt ./requirements.txt

# Install main Python dependencies (WhisperX compatible)
RUN pip install --no-cache-dir -r requirements.txt

# Install TTS dependencies
RUN pip install --no-cache-dir \
    torch>=2.0.0 \
    torchaudio>=2.0.0 \
    numpy>=1.21.0 \
    soundfile>=0.12.0 \
    transformers>=4.30.0 \
    piper-tts>=1.2.0

# Clone and install Higgs Audio
RUN git clone https://github.com/boson-ai/higgs-audio.git /opt/higgs-audio
WORKDIR /opt/higgs-audio

# Install Higgs Audio requirements
RUN pip install -r requirements.txt

# Install Higgs Audio in development mode
RUN pip install -e .

# Return to app directory
WORKDIR /app

# Download default Piper model
RUN mkdir -p /app/models/piper
WORKDIR /app/models/piper
RUN wget -O en_US-amy-low.onnx https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/en/en_US/amy/low/en_US-amy-low.onnx
RUN wget -O en_US-amy-low.onnx.json https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/en/en_US/amy/low/en_US-amy-low.onnx.json

# Return to app directory
WORKDIR /app

# Copy the voice service
COPY apps/voice/voice_service.py ./voice_service.py

# Create models directory
RUN mkdir -p /app/models

# Expose port
EXPOSE 9000

# Run the service
CMD ["python", "voice_service.py"] 