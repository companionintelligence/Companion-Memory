# Use Python 3.11 slim image as base
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements files
COPY apps/voice/requirements.txt ./requirements.txt
COPY apps/voice/requirements_higgs.txt ./requirements_higgs.txt

# Install main Python dependencies (WhisperX compatible)
RUN pip install --no-cache-dir -r requirements.txt

# Create a separate environment for Higgs Audio
RUN python -m venv /opt/higgs-env
ENV PATH="/opt/higgs-env/bin:$PATH"

# Install Higgs Audio dependencies in the separate environment (skip problematic packages)
RUN /opt/higgs-env/bin/pip install --no-cache-dir torch torchaudio numpy soundfile transformers==4.21.0 || true

# Copy the voice service
COPY apps/voice/voice_service.py ./voice_service.py

# Create models directory
RUN mkdir -p /app/models

# Expose port
EXPOSE 9000

# Run the service
CMD ["python", "voice_service.py"] 