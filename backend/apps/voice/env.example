# TTS Engine Configuration
# Choose between 'higgs' and 'piper'
TTS_ENGINE=higgs

# Piper TTS Model Configuration (only used when TTS_ENGINE=piper)
PIPER_MODEL_PATH=/app/models/piper/en_US-amy-low.onnx
PIPER_CONFIG_PATH=/app/models/piper/en_US-amy-low.onnx.json

# Voice Service Configuration
VOICE_SERVICE_PORT=9000
VOICE_SERVICE_HOST=0.0.0.0
