{
  "name": "@ci/auth-broker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=../../../.env nodemon --exec ts-node -r tsconfig-paths/register --swc src/main.ts",
    "dev:pretty": "yarn dev | yarn pino-pretty",
    "build": "yarn tsc --build --verbose && yarn tsc-alias --verbose",
    "clean": "rimraf dist",
    "exec": "DOTENV_CONFIG_PATH=../../../.env ts-node -r tsconfig-paths/register --swc",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "dbmate": "DOTENV_CONFIG_PATH=../../../.env node bin/dbmate.js",
    "migrate": "yarn dbmate up",
    "migrate:up": "yarn migrate",
    "migrate:down": "yarn dbmate down",
    "migrate:make": "yarn dbmate new"
  },
  "packageManager": "yarn@4.9.1",
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.7.9",
    "config": "^4.0.0",
    "dbmate": "^2.27.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.24",
    "uuid": "^11.1.0",
    "zod": "^3.25.34"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.5",
    "@swc/core": "^1.10.8",
    "@swc/register": "^0.1.10",
    "@types/config": "^3.3.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.21",
    "@types/passport": "^0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.2",
    "@yarnpkg/pnpify": "^4.1.4",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.1.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  }
}
