function blockCoversQuery(grant: GrantFacts, query: QueryFacts): bool
{
  if (grant.queryType != query.queryType) then
    false
  else
    match query.dataClass {
      case Some(i_query_dataClass_val) =>
        classMatchesQuery(grant, query)
      case None =>
        true
    }
}

lemma blockCoversQuery_ensures(grant: GrantFacts, query: QueryFacts)
