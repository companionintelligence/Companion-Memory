function actorSatisfiesDelegation(actor: Option<AskActor>, delegation: AskDelegation): bool
{
  match actor {
    case Some(i_actor_val) =>
      if delegation.none? then
        i_actor_val.kind.person?
      else
        if delegation.first_party_only? then
          (i_actor_val.kind.person? || i_actor_val.kind.first_party_agent?)
        else
          delegation.any_agent?
    case None =>
      false
  }
}

lemma actorSatisfiesDelegation_ensures(actor: Option<AskActor>, delegation: AskDelegation)
  ensures ((match actor { case Some(i_) => false case None => true }) ==> !(actorSatisfiesDelegation(actor, delegation)))
  ensures (actorSatisfiesDelegation(actor, delegation) ==> delegation.none? ==> ((match actor { case Some(i_) => true case None => false }) && actor.value.kind.person?))
  ensures (actorSatisfiesDelegation(actor, delegation) ==> delegation.first_party_only? ==> ((match actor { case Some(i_) => true case None => false }) && (!actor.value.kind.third_party_agent?)))
{
}

method decideGrant(query: QueryFacts, grants: seq<GrantFacts>) returns (res: GrantEvaluation)
  ensures forall g: GrantFacts :: ((g in grants) ==> g.active ==> g.mode.block? ==> blockCoversQuery(g, query) ==> res.decision.deny?)
  ensures (res.decision.deny? ==> exists g: GrantFacts :: (((((g in grants) && g.active) && g.mode.block?) && blockCoversQuery(g, query)) && (match res.grantId { case Some(i_value) => (i_value == g.id) case None => false })))
  ensures (res.decision.auto? ==> exists g: GrantFacts :: ((((((((g in grants) && g.active) && g.mode.auto?) && grantMatchesQuery(g, query)) && autoGrantNamesQueryClass(g, query)) && (match res.grantId { case Some(i_value) => (i_value == g.id) case None => false })) && (res.maxDisclosure == g.ceiling)) && forall o: GrantFacts :: ((o in grants) ==> o.active ==> o.mode.auto? ==> grantMatchesQuery(o, query) ==> autoGrantNamesQueryClass(o, query) ==> (g.ceilingRank <= o.ceilingRank))))
  ensures (match res.grantId { case Some(i_result_grantId_val) => (res.decision.review? ==> exists g: GrantFacts :: ((((((g in grants) && g.active) && (!g.mode.block?)) && grantMatchesQuery(g, query)) && (i_result_grantId_val == g.id)) && (res.maxDisclosure == g.ceiling))) case None => true })
  ensures ((match query.dataClass { case Some(i_) => false case None => true }) ==> (!res.decision.auto?))
  ensures ((match res.grantId { case Some(i_) => false case None => true }) ==> res.decision.review?)
{
  var active := SeqFilter((grant: GrantFacts) => grant.active, grants);
  var block := SeqFind(active, (grant: GrantFacts) => (grant.mode.block? && blockCoversQuery(grant, query)));
  match block {
    case Some(i_block_val) =>
      return GrantEvaluation(GrantDecision.deny, Some(i_block_val.id), None);
    case None =>

  }
  var matches := SeqFilter((grant: GrantFacts) => ((!grant.mode.block?) && grantMatchesQuery(grant, query)), active);
  var i_t0 := strictestOf(SeqFilter((grant: GrantFacts) => (grant.mode.auto? && autoGrantNamesQueryClass(grant, query)), matches));
  var auto := i_t0;
  match auto {
    case Some(i_auto_val) =>
      return GrantEvaluation(GrantDecision.auto, Some(i_auto_val.id), i_auto_val.ceiling);
    case None =>

  }
  var i_t1 := strictestOf(SeqFilter((grant: GrantFacts) => grant.mode.review?, matches));
  var i_t2 := strictestOf(SeqFilter((grant: GrantFacts) => grant.mode.auto?, matches));
  var review := (match i_t1 { case Some(i_oc0_val) => Option.Some(i_oc0_val) case None => i_t2 });
  match review {
    case Some(i_review_val) =>
      return GrantEvaluation(GrantDecision.review, Some(i_review_val.id), i_review_val.ceiling);
    case None =>

  }
  return GrantEvaluation(GrantDecision.review, None, None);
}

method strictestOf(grants: seq<GrantFacts>) returns (res: Option<GrantFacts>)
  ensures ((|grants| == 0) <==> (match res { case Some(i_) => false case None => true }))
  ensures (match res { case Some(i_result_val) => (i_result_val in grants) case None => true })
  ensures (match res { case Some(i_result_val) => forall g: GrantFacts :: ((g in grants) ==> (i_result_val.ceilingRank <= g.ceilingRank)) case None => true })
  ensures (match res { case Some(i_result_val) => forall g: GrantFacts :: ((g in grants) ==> (g.ceilingRank == i_result_val.ceilingRank) ==> (i_result_val.tieBreak <= g.tieBreak)) case None => true })
{
  var strictest := None;
  var i_grant_idx := 0;
  while i_grant_idx < |grants|
    invariant (i_grant_idx <= |grants|)
    invariant ((match strictest { case Some(i_) => false case None => true }) == (i_grant_idx == 0))
    invariant (match strictest { case Some(i_strictest_val) => exists k: nat :: ((k < i_grant_idx) && (grants[k] == i_strictest_val)) case None => true })
    invariant (match strictest { case Some(i_strictest_val) => forall k: nat :: ((k < i_grant_idx) ==> (i_strictest_val.ceilingRank <= grants[k].ceilingRank)) case None => true })
    invariant (match strictest { case Some(i_strictest_val) => forall k: nat :: ((k < i_grant_idx) ==> (grants[k].ceilingRank == i_strictest_val.ceilingRank) ==> (i_strictest_val.tieBreak <= grants[k].tieBreak)) case None => true })
  {
    var grant := grants[i_grant_idx];
    if (((match strictest { case Some(i_) => false case None => true }) || (grant.ceilingRank < strictest.value.ceilingRank)) || ((grant.ceilingRank == strictest.value.ceilingRank) && (grant.tieBreak < strictest.value.tieBreak))) {
      strictest := Some(grant);
    }
    i_grant_idx := i_grant_idx + 1;
  }
  return strictest;
}
