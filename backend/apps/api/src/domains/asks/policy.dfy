// Generated by lsc from policy.ts

datatype Option<T> = None | Some(value: T)

datatype Nullish<T> = Undefined | Null | Value(value: T)

function NatToString(n: nat): string
  decreases n
{
  var digit := ('0' as int + n % 10) as char;
  if n < 10 then [digit]
  else NatToString(n / 10) + [digit]
}

function IntToString(n: int): string
{
  if n < 0 then "-" + NatToString(-n) else NatToString(n)
}

datatype DisclosureRung = boolean | none | count | summary | redacted | full

datatype AnswerForm = boolean | existence | attribute | retrieval | identity

datatype DisclosedAnswer = DisclosedAnswer(form: AnswerForm, items: seq<DisclosedItem>, disclosedCount: int, withheldCount: int, summary: string, consentBasis: Option<string>)

datatype DisclosedItem = DisclosedItem(id: string, type_: string)

function rungIndex(rung: DisclosureRung): Option<int>
{
  if rung.none? then
    Some(0)
  else
    if rung.boolean? then
      Some(1)
    else
      if rung.count? then
        Some(2)
      else
        if rung.summary? then
          Some(3)
        else
          if rung.redacted? then
            Some(4)
          else
            if rung.full? then
              Some(5)
            else
              None
}

lemma rungIndex_ensures(rung: DisclosureRung)
  ensures (rung.none? ==> (match rungIndex(rung) { case Some(i_value) => (i_value == 0) case None => false }))
  ensures (rung.boolean? ==> (match rungIndex(rung) { case Some(i_value) => (i_value == 1) case None => false }))
  ensures (rung.count? ==> (match rungIndex(rung) { case Some(i_value) => (i_value == 2) case None => false }))
  ensures (rung.summary? ==> (match rungIndex(rung) { case Some(i_value) => (i_value == 3) case None => false }))
  ensures (rung.redacted? ==> (match rungIndex(rung) { case Some(i_value) => (i_value == 4) case None => false }))
  ensures (rung.full? ==> (match rungIndex(rung) { case Some(i_value) => (i_value == 5) case None => false }))
{
}

function rungAtLeast(a: DisclosureRung, b: DisclosureRung): bool
{
  var indexA := rungIndex(a);
  var indexB := rungIndex(b);
  (((match indexA { case Some(i_) => true case None => false }) && (match indexB { case Some(i_) => true case None => false })) && (indexA.value >= indexB.value))
}

lemma rungAtLeast_ensures(a: DisclosureRung, b: DisclosureRung)
  ensures ((a == b) ==> rungAtLeast(a, b))
  ensures (rungAtLeast(a, b) || rungAtLeast(b, a))
  ensures (rungAtLeast(a, b) ==> rungAtLeast(b, a) ==> (a == b))
  ensures forall c: DisclosureRung :: (rungAtLeast(a, b) ==> rungAtLeast(b, c) ==> rungAtLeast(a, c))
{
}

function minRung(a: DisclosureRung, b: DisclosureRung): DisclosureRung
{
  if rungAtLeast(b, a) then
    a
  else
    b
}

lemma minRung_ensures(a: DisclosureRung, b: DisclosureRung)
  ensures ((minRung(a, b) == a) || (minRung(a, b) == b))
  ensures rungAtLeast(a, minRung(a, b))
  ensures rungAtLeast(b, minRung(a, b))
  ensures forall c: DisclosureRung :: (rungAtLeast(a, c) ==> rungAtLeast(b, c) ==> rungAtLeast(minRung(a, b), c))
  ensures (minRung(a, b) == minRung(b, a))
{
}

function narrowestRung(a: Nullish<DisclosureRung>, b: Nullish<DisclosureRung>): Option<DisclosureRung>
{
  if !(a.Value?) then
    match b {
      case Value(i_oc0_val) =>
        Option.Some(i_oc0_val)
      case Null =>
        Option.None
      case Undefined =>
        Option.None
    }
  else
    if !(b.Value?) then
      Some(a.value)
    else
      Some(minRung(a.value, b.value))
}

lemma narrowestRung_ensures(a: Nullish<DisclosureRung>, b: Nullish<DisclosureRung>)
  ensures (!(a.Value?) ==> !(b.Value?) ==> (match narrowestRung(a, b) { case Some(i_) => false case None => true }))
  ensures (a.Value? ==> (match narrowestRung(a, b) { case Some(i_) => true case None => false }))
  ensures (b.Value? ==> (match narrowestRung(a, b) { case Some(i_) => true case None => false }))
  ensures (match narrowestRung(a, b) { case Some(i_result_val) => (a.Value? ==> rungAtLeast(a.value, i_result_val)) case None => true })
  ensures (match narrowestRung(a, b) { case Some(i_result_val) => (b.Value? ==> rungAtLeast(b.value, i_result_val)) case None => true })
  ensures (match narrowestRung(a, b) { case Some(i_result_val) => ((a.Value? && (i_result_val == a.value)) || (b.Value? && (i_result_val == b.value))) case None => true })
  ensures forall c: DisclosureRung :: (match narrowestRung(a, b) { case Some(i_result_val) => ((!(a.Value?) || rungAtLeast(a.value, c)) ==> (!(b.Value?) || rungAtLeast(b.value, c)) ==> rungAtLeast(i_result_val, c)) case None => true })
{
}

function narrowerForm(chosen: AnswerForm, inferred: AnswerForm): AnswerForm
{
  if rungAtLeast(rungForForm(inferred), rungForForm(chosen)) then
    chosen
  else
    inferred
}

lemma narrowerForm_ensures(chosen: AnswerForm, inferred: AnswerForm)
  ensures ((narrowerForm(chosen, inferred) == chosen) || (narrowerForm(chosen, inferred) == inferred))
  ensures rungAtLeast(rungForForm(chosen), rungForForm(narrowerForm(chosen, inferred)))
  ensures rungAtLeast(rungForForm(inferred), rungForForm(narrowerForm(chosen, inferred)))
  ensures (rungAtLeast(rungForForm(inferred), rungForForm(chosen)) ==> (narrowerForm(chosen, inferred) == chosen))
{
}

function rungForForm(form: AnswerForm): DisclosureRung
{
  match form {
    case boolean =>
      DisclosureRung.boolean
    case identity =>
      DisclosureRung.boolean
    case existence =>
      DisclosureRung.count
    case attribute =>
      DisclosureRung.summary
    case _ =>
      DisclosureRung.full
  }
}

lemma rungForForm_ensures(form: AnswerForm)
  ensures ((!form.retrieval?) ==> !(rungAtLeast(rungForForm(form), DisclosureRung.redacted)))
  ensures (form.boolean? ==> rungForForm(form).boolean?)
  ensures (form.identity? ==> rungForForm(form).boolean?)
  ensures (form.existence? ==> rungForForm(form).count?)
  ensures (form.attribute? ==> rungForForm(form).summary?)
  ensures (form.retrieval? ==> rungForForm(form).full?)
{
}

function applyDisclosureCeiling(answer: DisclosedAnswer, ceiling: DisclosureRung): DisclosedAnswer
{
  var natural := rungForForm(answer.form);
  var effective := minRung(natural, ceiling);
  if effective.full? then
    answer
  else
    if effective.redacted? then
      answer.(withheldCount := 0)
    else
      var base := answer.(items := []);
      match effective {
        case summary =>
          base.(withheldCount := 0)
        case count =>
          base.(withheldCount := 0, summary := countOnlySummary(answer.disclosedCount))
        case boolean =>
          base.(disclosedCount := (if (answer.disclosedCount > 0) then 1 else 0), withheldCount := 0, summary := (if (answer.disclosedCount > 0) then "Yes." else "No."))
        case _ =>
          base.(disclosedCount := 0, withheldCount := 0, summary := "Nothing was shared.")
      }
}

lemma applyDisclosureCeiling_ensures(answer: DisclosedAnswer, ceiling: DisclosureRung)
  ensures (applyDisclosureCeiling(answer, ceiling).form == answer.form)
  ensures (applyDisclosureCeiling(answer, ceiling).consentBasis == answer.consentBasis)
  ensures (rungAtLeast(rungForForm(answer.form), DisclosureRung.full) ==> rungAtLeast(ceiling, DisclosureRung.full) ==> (applyDisclosureCeiling(answer, ceiling) == answer))
  ensures (!(rungAtLeast(ceiling, DisclosureRung.full)) ==> (applyDisclosureCeiling(answer, ceiling).withheldCount == 0))
  ensures (!(rungAtLeast(rungForForm(answer.form), DisclosureRung.full)) ==> (applyDisclosureCeiling(answer, ceiling).withheldCount == 0))
  ensures (!(rungAtLeast(ceiling, DisclosureRung.redacted)) ==> (|applyDisclosureCeiling(answer, ceiling).items| == 0))
  ensures (!(rungAtLeast(rungForForm(answer.form), DisclosureRung.redacted)) ==> (|applyDisclosureCeiling(answer, ceiling).items| == 0))
  ensures (!(rungAtLeast(ceiling, DisclosureRung.count)) ==> ((applyDisclosureCeiling(answer, ceiling).disclosedCount == 0) || (applyDisclosureCeiling(answer, ceiling).disclosedCount == 1)))
  ensures (!(rungAtLeast(rungForForm(answer.form), DisclosureRung.count)) ==> ((applyDisclosureCeiling(answer, ceiling).disclosedCount == 0) || (applyDisclosureCeiling(answer, ceiling).disclosedCount == 1)))
  ensures (ceiling.none? ==> ((applyDisclosureCeiling(answer, ceiling).disclosedCount == 0) && (applyDisclosureCeiling(answer, ceiling).summary == "Nothing was shared.")))
  ensures (minRung(rungForForm(answer.form), ceiling).count? ==> (applyDisclosureCeiling(answer, ceiling).summary == countOnlySummary(answer.disclosedCount)))
  ensures (minRung(rungForForm(answer.form), ceiling).boolean? ==> (answer.disclosedCount > 0) ==> ((applyDisclosureCeiling(answer, ceiling).disclosedCount == 1) && (applyDisclosureCeiling(answer, ceiling).summary == "Yes.")))
  ensures (minRung(rungForForm(answer.form), ceiling).boolean? ==> !((answer.disclosedCount > 0)) ==> ((applyDisclosureCeiling(answer, ceiling).disclosedCount == 0) && (applyDisclosureCeiling(answer, ceiling).summary == "No.")))
  ensures ((|applyDisclosureCeiling(answer, ceiling).items| == 0) || (applyDisclosureCeiling(answer, ceiling).items == answer.items))
  ensures ((applyDisclosureCeiling(answer, ceiling).withheldCount == 0) || (applyDisclosureCeiling(answer, ceiling).withheldCount == answer.withheldCount))
  ensures (((applyDisclosureCeiling(answer, ceiling).disclosedCount == 0) || (applyDisclosureCeiling(answer, ceiling).disclosedCount == answer.disclosedCount)) || ((applyDisclosureCeiling(answer, ceiling).disclosedCount == 1) && (answer.disclosedCount > 0)))
  ensures (rungAtLeast(ceiling, DisclosureRung.summary) ==> rungAtLeast(rungForForm(answer.form), DisclosureRung.summary) ==> (applyDisclosureCeiling(answer, ceiling).summary == answer.summary))
  ensures forall c: DisclosureRung :: (rungAtLeast(ceiling, c) ==> ((|applyDisclosureCeiling(answer, c).items| == 0) || (applyDisclosureCeiling(answer, c).items == applyDisclosureCeiling(answer, ceiling).items)))
  ensures forall c: DisclosureRung :: (rungAtLeast(ceiling, c) ==> ((applyDisclosureCeiling(answer, c).withheldCount == 0) || (applyDisclosureCeiling(answer, c).withheldCount == applyDisclosureCeiling(answer, ceiling).withheldCount)))
  ensures forall c: DisclosureRung :: (rungAtLeast(ceiling, c) ==> (((applyDisclosureCeiling(answer, c).disclosedCount == 0) || (applyDisclosureCeiling(answer, c).disclosedCount == applyDisclosureCeiling(answer, ceiling).disclosedCount)) || ((applyDisclosureCeiling(answer, c).disclosedCount == 1) && (applyDisclosureCeiling(answer, ceiling).disclosedCount > 0))))
{
}

function countOnlySummary(count: int): string
{
  if (count == 1) then
    "1 matching item."
  else
    (("" + IntToString(count)) + " matching items.")
}
