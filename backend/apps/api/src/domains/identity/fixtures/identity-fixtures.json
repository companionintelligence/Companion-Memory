      "provider": "soundcloud",
      "providerRef": "soundcloud:track:jsmith/night-run-demo-1"
    },
    {
      "name": "soundcloud set is distinct from a track",
      "input": "https://soundcloud.com/jsmith/sets/demos",
      "canonical": "https://soundcloud.com/jsmith/sets/demos",
      "provider": "soundcloud",
      "providerRef": "soundcloud:set:jsmith/demos"
    },
    {
      "name": "soundcloud reserved paths are not tracks",
      "input": "https://soundcloud.com/discover/sets/personalized-tracks",
      "canonical": "https://soundcloud.com/discover/sets/personalized-tracks"
    },
    {
      "name": "on.soundcloud.com is a shortener, not a mirror",
      "input": "https://on.soundcloud.com/abc123",
      "canonical": null
    },
    {
      "name": "dailymotion drops the decorative title slug",
      "input": "https://www.dailymotion.com/video/x8abcd_some-title-that-changes",
