{
  "name": "@ci/be-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=../../../.env nodemon --watch src --watch config --watch ../../../.env --exec ts-node -r tsconfig-paths/register -r @swc/register src/main.ts",
    "build": "yarn tsc --build --verbose && yarn tsc-alias --verbose",
    "clean": "rimraf dist",
    "exec": "DOTENV_CONFIG_PATH=../../../.env ts-node -r tsconfig-paths/register -r @swc/register",
    "lint": "oxlint && eslint --cache",
    "lint:fix": "oxlint --fix && eslint --fix --cache",
    "depcheck": "yarn depcruise \"src/**/*.ts\" --ignore-known",
    "depcheck:accept": "depcruise \"src/**/*.ts\" --output-type baseline > .dependency-cruiser-known-violations.json",
    "typecheck": "tsc --noEmit",
    "dbmate": "DOTENV_CONFIG_PATH=../../../.env node bin/dbmate.js",
    "dbshell": "DOTENV_CONFIG_PATH=../../../.env node bin/dbshell.js",
    "dburl": "DOTENV_CONFIG_PATH=../../../.env node bin/dburl.js",
    "migrate": "yarn dbmate up",
    "migrate:up": "yarn migrate",
    "migrate:down": "yarn dbmate down",
    "migrate:make": "yarn dbmate new",
    "db:clear": "yarn dbmate --execute-file ./db/postgres/scripts/drop_all_pg_data.sql",
    "db:destroy": "yarn dbmate --execute-file ./db/postgres/scripts/drop_all_pg_tables.sql",
    "db:chatreset": "yarn dbmate --execute-file ./db/postgres/scripts/reset_demo_chats.sql",
    "db:filereset": "yarn dbmate --execute-file ./db/postgres/scripts/reset_demo_files.sql",
    "migration:run": "DOTENV_CONFIG_PATH=../../../.env ts-node -r tsconfig-paths/register --swc scripts/seed-database/run-migration.ts",
    "test": "DOTENV_CONFIG_PATH=../../../.env jest",
    "docs": "yarn docs:html",
    "docs:html": "typedoc",
    "docs:json": "typedoc --json docs/typedoc.json",
    "docs:capabilities": "yarn run exec -- scripts/build-capability-map-from-typedoc.ts",
    "graphql:generate": "yarn run exec -- scripts/generate-graphql-schema.ts"
  },
  "packageManager": "yarn@4.9.1",
  "dependencies": {
    "@apollo/server": "^5.4.0",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.823.0",
    "@aws-sdk/s3-request-presigner": "^3.823.0",
    "@inquirer/prompts": "^7.5.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/apollo": "^13.2.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/graphql": "^13.2.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.0",
    "config": "^4.0.0",
    "cookie-parser": "^1.4.7",
    "dataloader": "^2.2.3",
    "dbmate": "^2.27.0",
    "dlv": "^1.1.3",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^10.1.0",
    "googleapis": "^153.0.0",
    "graphql": "^16.12.0",
    "graphql-query-complexity": "^1.1.0",
    "graphql-type-json": "^0.3.2",
    "jose": "^6.1.3",
    "ollama": "^0.5.17",
    "p-limit": "^7.1.1",
    "parse-duration": "^2.1.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.0",
    "pg-boss": "^10.3.2",
    "pgvector": "^0.2.1",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "typeorm": "^0.3.26",
    "undici": "^8.2.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.34"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.5",
    "@swc/core": "^1.10.8",
    "@swc/jest": "^0.2.39",
    "@swc/register": "^0.1.10",
    "@types/bcrypt": "^5.0.2",
    "@types/cli-progress": "^3.11.6",
    "@types/config": "^3.3.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/dlv": "^1",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/graphql-query-complexity": "^0.2.1",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.21",
    "@types/passport": "^0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.15.2",
    "@types/supertest": "^6.0.3",
    "@yarnpkg/pnpify": "^4.1.4",
    "csv-parse": "^5.6.0",
    "dependency-cruiser": "^17.0.2",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.1.0",
    "jest": "^30.0.4",
    "jest-util": "^30.0.2",
    "knip": "^5.66.0",
    "nodemon": "^3.1.10",
    "oxlint": "^1.36.0",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  }
}
