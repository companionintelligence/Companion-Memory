{
  "name": "@ci/be-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=../../../.env nodemon --exec ts-node -r tsconfig-paths/register --swc src/main.ts",
    "dev:pretty": "yarn dev | yarn pino-pretty",
    "build": "yarn tsc --build --verbose && yarn tsc-alias --verbose",
    "clean": "rimraf dist",
    "exec": "DOTENV_CONFIG_PATH=../../../.env ts-node -r tsconfig-paths/register --swc",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:circular-imports": "madge . --extensions ts --circular",
    "typecheck": "tsc --noEmit",
    "dbmate": "DOTENV_CONFIG_PATH=../../../.env node bin/dbmate.js",
    "migrate": "yarn dbmate up",
    "migrate:up": "yarn migrate",
    "migrate:down": "yarn dbmate down",
    "migrate:make": "yarn dbmate new",
    "db:clear": "yarn dbmate --execute-file ./db/postgres/scripts/drop_all_pg_data.sql",
    "test": "DOTENV_CONFIG_PATH=../../../.env jest"
  },
  "packageManager": "yarn@4.9.1",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.823.0",
    "@aws-sdk/s3-request-presigner": "^3.823.0",
    "@inquirer/prompts": "^7.5.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "commander": "^14.0.0",
    "config": "^4.0.0",
    "dbmate": "^2.27.0",
    "dlv": "^1.1.3",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "google-auth-library": "^10.1.0",
    "googleapis": "^153.0.0",
    "ollama": "^0.5.17",
    "parse-duration": "^2.1.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.0",
    "pg-boss": "^10.3.2",
    "pgvector": "^0.2.1",
    "pino": "^9.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.24",
    "uuid": "^11.1.0",
    "zod": "^3.25.34"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.5",
    "@swc/core": "^1.10.8",
    "@swc/register": "^0.1.10",
    "@types/bcrypt": "^5.0.2",
    "@types/config": "^3.3.5",
    "@types/dlv": "^1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.21",
    "@types/passport": "^0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.15.2",
    "@types/supertest": "^6.0.3",
    "@yarnpkg/pnpify": "^4.1.4",
    "csv-parse": "^5.6.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.1.0",
    "jest": "^30.0.4",
    "jest-util": "^30.0.2",
    "madge": "^8.0.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  }
}
