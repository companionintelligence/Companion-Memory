{
  "name": "@ci/be-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsc --build ../../packages/tool-core/tsconfig.build.json && NODE_OPTIONS=--conditions=module-sync DOTENV_CONFIG_PATH=../../../.env nodemon --watch src --watch config --watch ../../../.env --ignore 'src/**/__tests__/**' --ignore 'src/**/__testHelpers__/**' --ignore 'src/**/*.spec.ts' --ignore 'src/**/*.test.ts' --exec ts-node -r tsconfig-paths/register -r @swc/register src/main.ts",
    "build": "yarn tsc --build --verbose && yarn tsc-alias --verbose",
    "clean": "rimraf dist",
    "exec": "tsc --build ../../packages/tool-core/tsconfig.build.json && DOTENV_CONFIG_PATH=../../../.env ts-node -r tsconfig-paths/register -r @swc/register",
    "lint": "oxlint && eslint --cache",
    "lint:fix": "oxlint --fix && eslint --fix --cache",
    "depcheck": "yarn depcruise \"src/**/*.ts\" \"bin/*.js\" --ignore-known",
    "depcheck:ratchet": "node ../../../scripts/check-depcheck-ratchet.mjs && yarn depcheck",
    "depcheck:accept": "depcruise \"src/**/*.ts\" \"bin/*.js\" --output-type baseline > .dependency-cruiser-known-violations.json",
    "typecheck": "tsc --build ../../packages/tool-core/tsconfig.build.json && tsc --noEmit",
    "dbmate": "DOTENV_CONFIG_PATH=../../../.env node bin/dbmate.js",
    "dbshell": "DOTENV_CONFIG_PATH=../../../.env node bin/dbshell.js",
    "dburl": "DOTENV_CONFIG_PATH=../../../.env node bin/dburl.js",
    "hub-account-link": "DOTENV_CONFIG_PATH=../../../.env node bin/hub-account-link.js",
    "check:migrations": "node bin/check-migration-versions.js && node bin/check-migration-directives.js",
    "migrate": "yarn check:migrations && yarn dbmate up",
    "pgboss:ensure": "node bin/ensure-pgboss-schema.js",
    "migrate:up": "yarn migrate",
    "migrate:down": "yarn dbmate down",
    "migrate:make": "yarn dbmate new",
    "db:clear": "yarn dbmate --execute-file ./db/postgres/scripts/drop_all_pg_data.sql",
    "db:destroy": "yarn dbmate --execute-file ./db/postgres/scripts/drop_all_pg_tables.sql",
    "db:chatreset": "yarn dbmate --execute-file ./db/postgres/scripts/reset_demo_chats.sql",
    "db:filereset": "yarn dbmate --execute-file ./db/postgres/scripts/reset_demo_files.sql",
    "migration:run": "DOTENV_CONFIG_PATH=../../../.env ts-node -r tsconfig-paths/register --swc scripts/seed-database/run-migration.ts",
    "test": "DOTENV_CONFIG_PATH=../../../.env jest",
    "test:unit": "DOTENV_CONFIG_PATH=../../../.env jest --testPathIgnorePatterns='\\.integration\\.(spec|test)\\.ts$'",
    "test:integration": "CI_REQUIRE_DB=1 DOTENV_CONFIG_PATH=../../../.env jest --testPathPattern='\\.integration\\.(spec|test)\\.ts$'",
    "docs": "yarn docs:html",
    "docs:html": "typedoc",
    "docs:json": "typedoc --json docs/typedoc.json",
    "docs:capabilities": "yarn run exec -- scripts/build-capability-map-from-typedoc.ts",
    "graphql:generate": "yarn run exec -- scripts/generate-graphql-schema.ts"
  },
  "packageManager": "yarn@4.9.1",
  "dependencies": {
    "@apollo/server": "^5.4.0",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@ci/tool-core": "workspace:^",
    "@inquirer/prompts": "^8.7.5",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@nestjs/apollo": "^14.1.2",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/graphql": "^14.1.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "@noble/hashes": "1.8.0",
    "@noble/post-quantum": "0.4.1",
    "@opentelemetry/api": "^1.9.1",
    "@sentry/nestjs": "^11.10.0",
    "adm-zip": "^0.6.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "config": "^4.0.0",
    "cookie-parser": "^1.4.7",
    "cron": "4.4.0",
    "csv-parse": "^7.0.2",
    "dataloader": "^2.2.3",
    "dbmate": "^2.37.0",
    "dlv": "^1.1.3",
    "dotenv": "^18.0.9",
    "entities": "4.5.0",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^11.3.2",
    "googleapis": "^189.0.0",
    "graphql": "^17.0.2",
    "graphql-query-complexity": "^2.0.0",
    "htmlparser2": "12.0.0",
    "jose": "^6.2.14",
    "mime-types": "^3.0.2",
    "multer": "^2.5.0",
    "ollama": "^0.6.4",
    "openai": "^7.47.0",
    "p-limit": "^7.1.1",
    "parse-duration": "^2.1.11",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.0",
    "pg-boss": "^12.38.0",
    "pgvector": "^0.3.0",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rrule": "^2.8.1",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2",
    "undici": "^8.12.2",
    "uuid": "^14.0.3",
    "web-push": "^3.6.7",
    "xml2js": "^0.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.21",
    "@swc/jest": "^0.2.39",
    "@swc/register": "^0.1.10",
    "@types/adm-zip": "^0.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cli-progress": "^3.11.6",
    "@types/config": "^3.3.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/dlv": "^1",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/graphql-query-complexity": "^0.2.1",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/passport": "^1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@types/xml2js": "^0",
    "@yarnpkg/pnpify": "^4.1.4",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "patch:eslint-plugin-import@npm%3A2.32.0#~/.yarn/patches/eslint-plugin-import-npm-2.32.0-a1643bce9b.patch",
    "globals": "^17.14.0",
    "jest": "^30.0.4",
    "jest-util": "^30.0.2",
    "knip": "^6.44.1",
    "nodemon": "^3.1.10",
    "oxlint": "^1.90.0",
    "pino-pretty": "^13.2.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1"
  }
}
