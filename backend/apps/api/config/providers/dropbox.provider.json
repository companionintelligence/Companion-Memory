{
  "id": "dropbox",
  "name": "Dropbox",
  "description": "Connect your Dropbox account to sync files and folders.",
  "logoUrl": "/branding/dropbox/logo.svg",
  "theme": {
    "backgroundColor": "#0061FF",
    "borderColor": "#0051D5"
  },
  "sources": [
    {
      "name": "Files",
      "description": "Your Dropbox files and folders",
      "enabledByDefault": true,
      "endpoints": ["ListFolder", "ListFolderContinue"],
      "scopes": ["files.metadata.read", "files.content.read"],
      "transformMap": "dropbox_files_to_content"
    }
  ],
  "auth": {
    "type": "oauth2",
    "authorizationUrl": "https://www.dropbox.com/oauth2/authorize",
    "tokenUrl": "https://api.dropboxapi.com/oauth2/token",
    "scopes": [],
    "extraParams": {}
  },
  "apiSpecId": "dropbox_api_v2",
  "enabled": true
}
