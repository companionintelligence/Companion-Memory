        "id": "0198779b-3c33-73da-84e5-82e0df145260"
      }
    },
    "oauth": {
      "callbackUrl": "https://dev.companionintelligence.com/oauth/callback"
    }
  },
  "db": {
    "type": "postgres",
    "host": "127.0.0.1",
    "port": 5432,
    "database": "companion_intel",
    "username": "POSTGRES_USERNAME",
    "password": "POSTGRES_PASSWORD"
