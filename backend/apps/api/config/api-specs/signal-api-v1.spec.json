{
  "id": "signal_api_v1",
  "name": "Signal API v1",
  "baseUrl": "http://localhost:3001/mock/signal",
  "version": "1",
  "meta": {
    "uniquenessField": "id",
    "defaultNameField": "name",
    "profileEndpoint": "v1/accounts/whoami"
  },
  "endpoints": {
    "GetMessages": {
      "name": "GetMessages",
      "method": "GET",
      "path": "/v1/receive",
      "responseType": "collection",
      "dataPath": "messages",
      "queryParams": {
        "timeout": {
          "type": "static",
          "value": 1
        }
      },
      "pagination": {
        "type": "none"
      },
      "rateLimit": {
        "requestsPerSecond": 10
      }
    }
  },
  "globalRateLimit": {
    "requestsPerSecond": 10
  }
}
