{
  "id": "telegram_messages_to_communication",
  "name": "Telegram Messages to Communication",
  "description": "Transforms Telegram API message format into internal Communication schema",
  "sourceType": "telegram_message",
  "targetType": "communication",
  "fields": {
    "externalId": {
      "type": "direct",
      "source": "message_id",
      "transform": {
        "type": "string"
      },
      "required": true
    },
    "title": {
      "type": "computed",
      "compute": {
        "function": "generateTelegramMessageTitle",
        "inputs": ["chat", "from"]
      },
      "default": "Telegram Message"
    },
    "content": {
      "type": "direct",
      "source": "text"
    },
    "sender": {
      "type": "computed",
      "compute": {
        "function": "extractTelegramSender",
        "inputs": ["from"]
      }
    },
    "timestamp": {
      "type": "direct",
      "source": "date",
      "transform": {
        "type": "date",
        "format": "unix"
      },
      "required": true
    },
    "type": {
      "type": "constant",
      "constantValue": "chat"
    },
    "platform": {
      "type": "constant",
      "constantValue": "telegram"
    },
    "chatId": {
      "type": "nested",
      "path": "chat.id"
    },
    "chatType": {
      "type": "nested",
      "path": "chat.type"
    }
  },
  "transformers": [
    "generateTelegramMessageTitle",
    "extractTelegramSender"
  ],
  "metadata": {
    "author": "CI-Server ETL Team",
    "version": "1.0.0",
    "tags": ["telegram", "messages", "communication", "chat"],
    "notes": "Handles Telegram messages from chats and groups."
  },
  "enabled": true
}
