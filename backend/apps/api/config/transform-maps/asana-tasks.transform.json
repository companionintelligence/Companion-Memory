{
  "id": "asana_tasks_to_content",
  "name": "Asana Tasks to Content",
  "description": "Transforms Asana API task format into internal Content schema",
  "sourceType": "asana_task",
  "targetType": "content",
  "fields": {
    "externalId": {
      "type": "direct",
      "source": "gid",
      "required": true
    },
    "title": {
      "type": "direct",
      "source": "name",
      "required": true
    },
    "description": {
      "type": "direct",
      "source": "notes"
    },
    "createdAt": {
      "type": "direct",
      "source": "created_at",
      "transform": {
        "type": "date"
      }
    },
    "modifiedAt": {
      "type": "direct",
      "source": "modified_at",
      "transform": {
        "type": "date"
      }
    },
    "platform": {
      "type": "constant",
      "constantValue": "asana"
    },
    "type": {
      "type": "constant",
      "constantValue": "task"
    },
    "category": {
      "type": "constant",
      "constantValue": "task"
    },
    "completed": {
      "type": "direct",
      "source": "completed"
    },
    "dueDate": {
      "type": "direct",
      "source": "due_on",
      "transform": {
        "type": "date"
      }
    },
    "assignee": {
      "type": "nested",
      "path": "assignee.name"
    },
    "url": {
      "type": "computed",
      "compute": {
        "function": "generateAsanaTaskUrl",
        "inputs": ["gid"]
      }
    }
  },
  "transformers": [
    "generateAsanaTaskUrl"
  ],
  "metadata": {
    "author": "CI-Server ETL Team",
    "version": "1.0.0",
    "tags": ["asana", "tasks", "content", "project-management"],
    "notes": "Handles Asana tasks with completion status and due dates."
  },
  "enabled": true
}
