{
  "id": "github_repos_to_content",
  "name": "GitHub Repositories to Content",
  "description": "Transforms GitHub API repository format into internal Content schema",
  "sourceType": "github_repository",
  "targetType": "content",
  "fields": {
    "externalId": {
      "type": "direct",
      "source": "id",
      "transform": {
        "type": "string"
      },
      "required": true
    },
    "title": {
      "type": "direct",
      "source": "name",
      "required": true
    },
    "description": {
      "type": "direct",
      "source": "description"
    },
    "url": {
      "type": "direct",
      "source": "html_url"
    },
    "createdAt": {
      "type": "direct",
      "source": "created_at",
      "transform": {
        "type": "date"
      }
    },
    "modifiedAt": {
      "type": "direct",
      "source": "updated_at",
      "transform": {
        "type": "date"
      }
    },
    "platform": {
      "type": "constant",
      "constantValue": "github"
    },
    "type": {
      "type": "constant",
      "constantValue": "repository"
    },
    "category": {
      "type": "constant",
      "constantValue": "code"
    },
    "language": {
      "type": "direct",
      "source": "language"
    },
    "metadata": {
      "type": "template",
      "template": "{\"stars\":{{ stargazers_count }},\"forks\":{{ forks_count }},\"private\":{{ private }}}"
    }
  },
  "transformers": [],
  "metadata": {
    "author": "CI-Server ETL Team",
    "version": "1.0.0",
    "tags": ["github", "repositories", "content", "code"],
    "notes": "Handles GitHub repositories with stats."
  },
  "enabled": true
}
