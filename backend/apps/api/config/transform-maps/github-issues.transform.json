{
  "id": "github_issues_to_content",
  "name": "GitHub Issues to Content",
  "description": "Transforms GitHub API issue format into internal Content schema",
  "sourceType": "github_issue",
  "targetType": "content",
  "fields": {
    "externalId": {
      "type": "direct",
      "source": "id",
      "transform": {
        "type": "string"
      },
      "required": true
    },
    "title": {
      "type": "direct",
      "source": "title",
      "required": true
    },
    "description": {
      "type": "direct",
      "source": "body"
    },
    "url": {
      "type": "direct",
      "source": "html_url"
    },
    "createdAt": {
      "type": "direct",
      "source": "created_at",
      "transform": {
        "type": "date"
      }
    },
    "modifiedAt": {
      "type": "direct",
      "source": "updated_at",
      "transform": {
        "type": "date"
      }
    },
    "platform": {
      "type": "constant",
      "constantValue": "github"
    },
    "type": {
      "type": "constant",
      "constantValue": "issue"
    },
    "category": {
      "type": "constant",
      "constantValue": "task"
    },
    "status": {
      "type": "direct",
      "source": "state"
    },
    "assignee": {
      "type": "nested",
      "path": "assignee.login"
    },
    "labels": {
      "type": "computed",
      "compute": {
        "function": "extractGitHubLabels",
        "inputs": ["labels"]
      }
    }
  },
  "transformers": [
    "extractGitHubLabels"
  ],
  "metadata": {
    "author": "CI-Server ETL Team",
    "version": "1.0.0",
    "tags": ["github", "issues", "content", "tasks"],
    "notes": "Handles GitHub issues with state and labels."
  },
  "enabled": true
}
