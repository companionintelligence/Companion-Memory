{
  "id": "github_prs_to_content",
  "name": "GitHub Pull Requests to Content",
  "description": "Transforms GitHub API pull request format into internal Content schema",
  "sourceType": "github_pull_request",
  "targetType": "content",
  "fields": {
    "externalId": {
      "type": "direct",
      "source": "id",
      "transform": {
        "type": "string"
      },
      "required": true
    },
    "title": {
      "type": "direct",
      "source": "title",
      "required": true
    },
    "description": {
      "type": "direct",
      "source": "body"
    },
    "url": {
      "type": "direct",
      "source": "html_url"
    },
    "createdAt": {
      "type": "direct",
      "source": "created_at",
      "transform": {
        "type": "date"
      }
    },
    "modifiedAt": {
      "type": "direct",
      "source": "updated_at",
      "transform": {
        "type": "date"
      }
    },
    "platform": {
      "type": "constant",
      "constantValue": "github"
    },
    "type": {
      "type": "constant",
      "constantValue": "pull_request"
    },
    "category": {
      "type": "constant",
      "constantValue": "code"
    },
    "status": {
      "type": "direct",
      "source": "state"
    },
    "merged": {
      "type": "direct",
      "source": "merged"
    },
    "author": {
      "type": "nested",
      "path": "user.login"
    }
  },
  "transformers": [],
  "metadata": {
    "author": "CI-Server ETL Team",
    "version": "1.0.0",
    "tags": ["github", "pull-requests", "content", "code"],
    "notes": "Handles GitHub PRs with merge status."
  },
  "enabled": true
}
