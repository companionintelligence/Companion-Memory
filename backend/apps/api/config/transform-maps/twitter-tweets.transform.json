{
  "id": "twitter_tweets_to_content",
  "name": "Twitter Tweets to Content",
  "description": "Transforms Twitter API v2 tweet format into internal Content schema",
  "sourceType": "twitter_tweet",
  "targetType": "content",
  "fields": {
    "externalId": {
      "type": "direct",
      "source": "id",
      "required": true
    },
    "title": {
      "type": "computed",
      "compute": {
        "function": "generateTweetTitle",
        "inputs": ["text"]
      },
      "default": "Tweet"
    },
    "description": {
      "type": "direct",
      "source": "text"
    },
    "createdAt": {
      "type": "direct",
      "source": "created_at",
      "transform": {
        "type": "date"
      }
    },
    "platform": {
      "type": "constant",
      "constantValue": "twitter"
    },
    "type": {
      "type": "constant",
      "constantValue": "tweet"
    },
    "category": {
      "type": "constant",
      "constantValue": "social_post"
    },
    "url": {
      "type": "computed",
      "compute": {
        "function": "generateTweetUrl",
        "inputs": ["id", "author_id"]
      }
    },
    "metadata": {
      "type": "template",
      "template": "{\"retweet_count\":{{ public_metrics.retweet_count }},\"like_count\":{{ public_metrics.like_count }}}"
    }
  },
  "transformers": [
    "generateTweetTitle",
    "generateTweetUrl"
  ],
  "metadata": {
    "author": "CI-Server ETL Team",
    "version": "1.0.0",
    "tags": ["twitter", "tweets", "content", "social"],
    "notes": "Handles Twitter API v2 tweet format with public metrics."
  },
  "enabled": true
}
