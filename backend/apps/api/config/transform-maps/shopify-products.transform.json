{
  "id": "shopify_products_to_content",
  "name": "Shopify Products to Content",
  "description": "Transforms Shopify API product format into internal Content schema",
  "sourceType": "shopify_product",
  "targetType": "content",
  "fields": {
    "externalId": {
      "type": "direct",
      "source": "id",
      "transform": {
        "type": "string"
      },
      "required": true
    },
    "title": {
      "type": "direct",
      "source": "title",
      "required": true
    },
    "description": {
      "type": "direct",
      "source": "body_html"
    },
    "thumbnailUrl": {
      "type": "nested",
      "path": "image.src"
    },
    "createdAt": {
      "type": "direct",
      "source": "created_at",
      "transform": {
        "type": "date"
      }
    },
    "modifiedAt": {
      "type": "direct",
      "source": "updated_at",
      "transform": {
        "type": "date"
      }
    },
    "platform": {
      "type": "constant",
      "constantValue": "shopify"
    },
    "type": {
      "type": "constant",
      "constantValue": "product"
    },
    "category": {
      "type": "constant",
      "constantValue": "commerce"
    },
    "vendor": {
      "type": "direct",
      "source": "vendor"
    },
    "productType": {
      "type": "direct",
      "source": "product_type"
    },
    "tags": {
      "type": "direct",
      "source": "tags"
    }
  },
  "transformers": [],
  "metadata": {
    "author": "CI-Server ETL Team",
    "version": "1.0.0",
    "tags": ["shopify", "products", "content", "commerce"],
    "notes": "Handles Shopify products with vendor and type."
  },
  "enabled": true
}
