{
  "servers": {
    "filesystem": {
      "name": "File System Access",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/tmp",
        "/path/to/allowed/directory"
      ],
      "enabled": true,
      "description": "Provides file system operations for the assistant",
      "timeout": 30000,
      "healthCheck": {
        "enabled": true,
        "intervalMs": 30000,
        "timeoutMs": 5000,
        "retryCount": 3,
        "restartOnFailure": true
      }
    },
    "web-search": {
      "name": "Web Search Engine",
      "command": "node",
      "args": [
        "dist/index.js"
      ],
      "workingDirectory": "/path/to/web-search-mcp",
      "enabled": true,
      "description": "Multi-engine web search with Google/DuckDuckGo fallback and content extraction",
      "timeout": 60000,
      "healthCheck": {
        "enabled": true,
        "intervalMs": 120000,
        "timeoutMs": 20000,
        "retryCount": 2,
        "restartOnFailure": true
      }
    }
  }
}