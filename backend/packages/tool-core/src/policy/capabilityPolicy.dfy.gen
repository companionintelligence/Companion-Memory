// Generated by lsc from capabilityPolicy.ts

datatype GatedPrivacy = GatedPrivacy(access: IntentAccess, destructive: bool)

datatype IntentAccess = read | write | delete

datatype ToolCapability = read | write | full

function removesData(privacy: GatedPrivacy): bool
{
  (privacy.access.delete? || privacy.destructive)
}

lemma removesData_ensures(privacy: GatedPrivacy)
  ensures (removesData(privacy) <==> (privacy.access.delete? || privacy.destructive))
{
}

function capabilityAllows(privacy: GatedPrivacy, capability: ToolCapability): bool
{
  (capability.full? || (if removesData(privacy) then false else (capability.write? || privacy.access.read?)))
}

lemma capabilityAllows_ensures(privacy: GatedPrivacy, capability: ToolCapability)
  ensures (capability.full? ==> capabilityAllows(privacy, capability))
  ensures (removesData(privacy) ==> capabilityAllows(privacy, capability) ==> capability.full?)
  ensures (capability.write? ==> (capabilityAllows(privacy, capability) <==> !(removesData(privacy))))
  ensures (capability.read? ==> (capabilityAllows(privacy, capability) <==> (privacy.access.read? && !(privacy.destructive))))
  ensures (capability.read? ==> capabilityAllows(privacy, capability) ==> capabilityAllows(privacy, ToolCapability.write))
  ensures (capability.write? ==> capabilityAllows(privacy, capability) ==> capabilityAllows(privacy, ToolCapability.full))
{
}

function capabilityRequiredFor(privacy: GatedPrivacy): ToolCapability
{
  if removesData(privacy) then
    ToolCapability.full
  else
    if privacy.access.read? then
      ToolCapability.read
    else
      ToolCapability.write
}

lemma capabilityRequiredFor_ensures(privacy: GatedPrivacy)
  ensures capabilityAllows(privacy, capabilityRequiredFor(privacy))
  ensures (capabilityRequiredFor(privacy).write? ==> !(capabilityAllows(privacy, ToolCapability.read)))
  ensures (capabilityRequiredFor(privacy).full? ==> !(capabilityAllows(privacy, ToolCapability.write)))
  ensures (removesData(privacy) <==> capabilityRequiredFor(privacy).full?)
{
}
